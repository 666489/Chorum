{
  "name": "chorum",
  "version": "0.5.0",
  "description": "Chorum：本地多智能体协作中枢。自动识别本机已装的 AI Agent CLI，也能直连 API 模型，装配成一条群聊 / 圆桌 / 持续执行的工作面",
  "keywords": [
    "chorum",
    "multi-agent",
    "agent-hub",
    "claude",
    "codex",
    "codebuddy",
    "deepseek",
    "api-model",
    "tool-calling",
    "cli",
    "mcp"
  ],
  "bin": {
    "chorum": "bin/cli.js",
    "chorum-hub": "bin/cli.js",
    "claudelink-hub": "bin/cli.js",
    "claude-hub": "bin/cli.js"
  },
  "files": [
    "bin/attach.js",
    "bin/cli.js",
    "bin/detect.js",
    "bin/env.js",
    "bin/everything.js",
    "bin/model.js",
    "bin/postinstall.js",
    "bin/registry.js",
    "bin/setup.js",
    "bin/util.js",
    "hub.py",
    "hub_pid.py",
    "hub_connection.py",
    "hub_tui.py",
    "tui_workspace.py",
    "extract.py",
    "web/index.html",
    "web/workbench.js",
    "web/workbench.css",
    "web/theme",
    "docs/README.md",
    "docs/manual.md",
    "docs/ops.md",
    "docs/packaging.md",
    "docs/agent-integration.md",
    "docs/roundtable.md",
    "docs/upgrade-0.3.md",
    "docs/upgrade-0.4.md",
    "docs/upgrade-0.5.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "config.example.json",
    "runtime.py",
    "codex_cli.py",
    "workflows.py"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/check-secrets.js",
    "check": "node scripts/check-secrets.js",
    "postinstall": "node bin/postinstall.js",
    "detect": "node bin/cli.js detect",
    "doctor": "node bin/cli.js doctor",
    "setup": "node bin/cli.js setup",
    "start": "node bin/cli.js start",
    "status": "node bin/cli.js status",
    "ui": "node bin/cli.js ui",
    "tui": "node bin/cli.js tui",
    "model": "node bin/cli.js model list",
    "selftest": "node scripts/selftest.js",
    "smoke": "node scripts/smoke.js",
    "pkg-e2e": "node scripts/pkg-e2e.js",
    "e2e:model": "node scripts/model-e2e.js",
    "ops": "npm run check && npm run selftest && npm run smoke && npm run pkg-e2e",
    "test": "node scripts/regression.js",
    "test:browser": "node scripts/browser-e2e.js",
    "test:lifecycle": "node scripts/test_lifecycle.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "license": "MIT"
}
