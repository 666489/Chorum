async function stopAllRuns(){
  const btn = document.getElementById('stop');
  if(btn) btn.disabled = true;
  const r = await post('/api/stop', {disable_relay: true});
  if(!r.ok){ alert('停止失败：' + r.error); if(btn) btn.disabled = false; return; }
  const names = (r.stopped || []).map(n=>labelOf(n)).join('、') || '（没有在跑的轮次）';
  log.querySelectorAll('[data-stop-note]').forEach(n=>n.remove());   // 只留最新一条，不用定时器
  const note = document.createElement('div');
  note.className = 'sys';
  note.dataset.ephemeral = '1';
  note.dataset.stopNote = '1';
  note.textContent = `已停止：${names}`
    + (r.relay_was ? '；自动接力已关闭（状态栏「接力」可重新开启）' : '');
  log.appendChild(note);
  if(document.getElementById('followState').checked && !followPaused) scrollLogToBottom();
  await loadAgents();
}
