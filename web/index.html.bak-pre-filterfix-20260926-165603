<script>
const FIXED_LABELS = { user:'我', system:'系统', claudelink:'ClaudeLink' };
const ICONS = {
  agents: '<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 19.5c0-3.3 2.9-5.5 6.5-5.5s6.5 2.2 6.5 5.5"/></svg>',
  pulse: '<svg viewBox="0 0 24 24"><path d="M3 12h4l2.5-6 4 12L16 12h5"/></svg>',
  bookmark: '<svg viewBox="0 0 24 24"><path d="M7 4h10v16l-5-4-5 4z"/></svg>',
  search: '<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M15.5 15.5 20 20"/></svg>',
  plug: '<svg viewBox="0 0 24 24"><path d="M12 3v6"/><path d="M9 9h6v3a3 3 0 0 1-3 3 3 3 0 0 1-3-3z"/><path d="M12 15v6"/></svg>',
  chat: '<svg viewBox="0 0 24 24"><path d="M4 5h16v10H8l-4 4z"/></svg>',
  chevron: '<svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg>',
  gear: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg>'
};
const log = document.getElementById('log');
const sidebar = document.getElementById('sidebar');
const activity = document.getElementById('activity');
let agents = [];
let msgs = [];
let target = 'all';
let filters = { kw:'', sender:'all', onlyHl:false, kinds:{ user:true, reply:true, error:true, event:true, claudelink:true } };
let es = null;
let actItems = [];
let activePanel = localStorage.getItem('hub.panel') || 'agents';
let healthCache = null;
let pillOn = false;
let perms = [];
let HUB_CWD = '';
let memberPanelFor = null;

const esc = s => { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; };
const hhmmss = ts => ts ? new Date(ts*1000).toLocaleTimeString('zh-CN',{hour12:false}) : '—';
const icon = name => (name && name.trim().startsWith('<svg')) ? name : (ICONS[name] || ICONS.chat);
const labelOf = name => (agents.find(a=>a.name===name)||{}).label || FIXED_LABELS[name] || name;
const kindClass = m => {
  if(m.kind === 'error') return 'msg ' + m.sender + ' error';
  if(m.kind === 'claudelink') return 'msg claudelink';
  if(FIXED_LABELS[m.sender]) return 'msg ' + m.sender;
  return (agents.find(a=>a.name===m.sender) || {}).kind === 'cli' ? 'msg ' + m.sender : 'msg model';
};
const passFilter = m => {
  if(filters.sender !== 'all' && m.sender !== filters.sender && m.target !== filters.sender) return false;
  if(filters.kw && !(m.text||'').toLowerCase().includes(filters.kw.toLowerCase())) return false;
  if(filters.onlyHl && !m.highlight) return false;
  if(m.kind === 'user' && !filters.kinds.user) return false;
  if(m.kind === 'reply' && !filters.kinds.reply) return false;
  if(m.kind === 'error' && !filters.kinds.error) return false;
  if(m.kind === 'event' && !filters.kinds.event) return false;
  if(m.kind === 'claudelink' && !filters.kinds.mirror) return false;
  return true;
};
const filterActive = () => !!(filters.kw || filters.sender !== 'all' || filters.onlyHl ||
  Object.values(filters.kinds).some(v=>!v));

/* ---------- 活动栏 + 面板 ---------- */
function renderActivity(){
  activity.innerHTML = '';
  actItems.forEach(it=>{
    const b = document.createElement('button');
    b.className = 'act' + (it.action ? '' : (it.id === activePanel ? ' on' : ''));
    b.title = it.title || it.id;
    b.dataset.id = it.id;
    b.innerHTML = icon(it.icon);
    b.onclick = ()=>{
      if(it.action === 'dialog'){ openModelDialog(); return; }
      if(sidebar.classList.contains('hidden')){ setCollapsed(false); setPanel(it.id); return; }
      if(activePanel === it.id){ setCollapsed(true); return; }
      setPanel(it.id);
    };
    activity.appendChild(b);
  });
  const sp = document.createElement('div'); sp.className = 'spacer'; activity.appendChild(sp);
  const toggle = document.createElement('button');
  toggle.className = 'act';
  toggle.dataset.act = 'collapse';
  toggle.title = '收起 / 展开侧边栏（Ctrl+B）';
  toggle.innerHTML = ICONS.chevron;
  toggle.onclick = ()=> setCollapsed(!sidebar.classList.contains('hidden'));
  activity.appendChild(toggle);
}

function setPanel(id){
  const known = [...document.querySelectorAll('.panel')].map(p=>p.dataset.panel);
  if(!known.includes(id)) id = known[0] || 'agents';
  activePanel = id;
  localStorage.setItem('hub.panel', id);
  document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('on', p.dataset.panel === id));
  renderActivity();
}

function setCollapsed(hidden){
  sidebar.classList.toggle('hidden', hidden);
  activity.classList.toggle('collapsed', hidden);
  localStorage.setItem('hub.collapsed', hidden ? '1' : '0');
}

/* ---------- 底部状态栏 ---------- */
function renderStatus(){
  const st = document.getElementById('status');
  const h = healthCache || {};
  const running = (h.running || []).length;
  const stopBtn = document.getElementById('stop');
  if(stopBtn){
    const busy = running > 0 || agents.some(a=>a.running_since);
    stopBtn.disabled = !busy;
    stopBtn.classList.toggle('live', busy);
    stopBtn.title = busy
      ? `停止：中断正在跑的 ${agents.filter(a=>a.running_since).map(a=>a.label).join('、') || running + ' 个轮次'}，并关闭自动接力（Esc）`
      : '停止：当前没有在跑的轮次（Esc）';
  }
  const connected = es && es.readyState === 1;
  const follow = document.getElementById('followState').checked;
  const relay = document.getElementById('relayState').checked;
  const parts = [
    `<span class="st ${connected?'dot-green':'dot-red'}" data-go="reconnect" title="点击重连">${connected?'已连接':'已断开'}</span>`,
    `<span class="st" data-go="info" title="中枢地址">${location.host}</span>`,
    `<span class="st" data-go="agents" title="启用 / 全部成员">成员 ${h.agents_enabled ?? '-'}/${h.agents_total ?? '-'}</span>`,
    `<span class="st ${running?'dot-amber':''}" data-go="health" title="正在处理">处理中 ${running}</span>`,
    `<span class="st" data-go="filter" title="已加载消息数 / 失败轮次">消息 ${msgs.length} · 失败 ${h.errors ?? 0}</span>`,
    `<span class="st" data-go="share" title="上下文来源">记忆 窗口 ${h.history_limit ?? ''}${(agents.find(a=>a.native_memory)||{}).label ? ' · 原生:' + agents.filter(a=>a.native_memory).map(a=>a.label).join(',') : ''}</span>`,
    `<span class="st" data-go="filter" title="筛选状态">筛选 ${filterActive()?'开':'关'}</span>`,
    '<span class="spacer"></span>',
    `<span class="st" data-go="bottom" title="跳到底部并恢复跟随" id="newPill"${pillOn?'':' style="display:none"'}>${
      followPaused ? '已暂停跟随 · 有新消息 ↓' : '有新消息 ↓'}</span>`,
    `<span class="st ${follow ? (followPaused ? '' : '') : 'off'}" data-go="follow"
      title="点击切换跟随；往上滚会自动暂停">跟随 ${
        follow ? (followPaused ? '开(已暂停)' : '开') : '关'}</span>`,
    `<span class="st ${relay?'':'off'}" data-go="relay" title="点击切换自动接力">接力 ${relay?'开':'关'}</span>`,
    `<span class="st" data-go="target" title="当前发送对象">目标 ${target==='all'?'全体':labelOf(target)}</span>`,
  ];
  st.innerHTML = parts.join('');
  st.querySelectorAll('.st').forEach(el=>{
    el.onclick = ()=> statusClick(el.getAttribute('data-go'));
  });
}

function statusClick(go){
  if(go === 'reconnect'){ connect(); return; }
  if(go === 'agents' || go === 'health' || go === 'share' || go === 'filter'){ setCollapsed(false); setPanel(go); return; }
  if(go === 'bottom'){ jumpBottom(); return; }
  if(go === 'target'){ document.getElementById('targets').scrollIntoView({block:'nearest'}); return; }
  if(go === 'follow'){
    const c = document.getElementById('followState');
    if(c.checked && followPaused){
      followPaused = false;                 // 已开但暂停 → 先恢复跟随
    } else {
      c.checked = !c.checked;
      followPaused = false;
    }
    localStorage.setItem('hub.follow', c.checked ? '1' : '0');
    renderStatus();
    return;
  }
  if(go === 'relay'){ const c = document.getElementById('relayState'); c.checked = !c.checked; c.onchange({target:c}); renderStatus(); return; }
}

/* ---------- 消息渲染 ---------- */
function nodeFor(m){
  if(m.kind === 'perm'){
    const d = document.createElement('div');
    d.className = 'msg perm';
    d.dataset.id = m.id;
    const rid = (m.ref || '').split(':')[1] || '';
    d.innerHTML = `<div class="hd"><span class="who">权限申请</span><span>${hhmmss(m.ts)}</span></div>`
      + `<div class="perm"><div class="t">${esc(labelOf(m.sender))} 需要权限</div>`
      + `<div class="p">${esc(m.text)}</div>`
      + `<div class="a"><button class="ok" data-perm-ok="${rid}">同意</button>`
      + `<button class="no" data-perm-no="${rid}">拒绝</button></div></div>`;
    return d;
  }
  if(m.kind === 'event'){
    const d = document.createElement('div');
    d.className = 'sys';
    d.dataset.id = m.id;
    d.innerHTML = esc(m.text)
                + (m.highlight ? '' : ' <button data-hl="'+m.id+'">整条高亮</button>')
                + ' <button class="delmsg" data-del="'+m.id+'">删除</button>';
    if(m.highlight) d.classList.add('hl');
    return d;
  }
  const div = document.createElement('div');
  const segs = m.highlights || [];
  div.className = kindClass(m) + (m.highlight ? (segs.length ? ' hlfrag' : ' hl') : '');
  div.dataset.id = m.id;
  const tgt = m.target && m.target !== 'all' ? `<span class="chip">→ ${esc(labelOf(m.target))}</span>` : '';
  const acts = [];
  if(m.can_retry) acts.push('<button class="retry" data-retry="'+m.id+'">重试这条</button>');
  if(m.kind === 'user' || m.kind === 'reply') acts.push('<button data-edit="'+m.id+'">改写</button>');
  acts.push(m.highlight
    ? ''
    : '<button data-hl="'+m.id+'">整条高亮</button>');
  acts.push('<button class="danger" data-del="'+m.id+'">删除</button>');
  const star = m.highlight ? `<span class="star">★ 重要${segs.length>1?'×'+segs.length:''}</span>` : '';
  const atts = (m.attachments || []).map(a=>`<span class="att-chip" title="${esc(a.kind)}">📎 ${esc(a.name)}</span>`).join(' ');
  const shown = m.display_text != null ? m.display_text : m.text;
  div.innerHTML = `<div class="hd"><span class="who">${esc(labelOf(m.sender))}</span>${tgt}${star}<span>${hhmmss(m.ts)}</span>${acts.join('')}</div>`
    + (atts ? `<div class="att-row">${atts}</div>` : '')
    + `<div class="body">${m.display_text != null ? esc(shown) : bodyHtml(m)}</div>`;
  return div;
}

function bodyHtml(m){
  const text = m.text || '';
  const segs = (m.highlights || []).slice().sort((a,b)=>a.start-b.start);
  if(!segs.length) return esc(text);
  let out = '', pos = 0;
  segs.forEach(s0=>{
    const s = Math.max(0, Math.min(text.length, s0.start));
    const e = Math.max(s, Math.min(text.length, s0.end));
    if(s < pos) return;
    out += esc(text.slice(pos, s));
    out += '<span class="hlseg">' + esc(text.slice(s, e)) + '</span>';
    pos = e;
  });
  out += esc(text.slice(pos));
  return out;
}

function applyMessageHighlight(m){
  const i = msgs.findIndex(x=>x.id === m.id);
  if(i >= 0) msgs[i] = m;
  const node = log.querySelector(`[data-id="${m.id}"]`);
  if(!node) return;
  node.replaceWith(nodeFor(m));   // 只替换这一条，不动其它节点与滚动位置
}

function startEdit(node, m){
  const box = node.querySelector('.body');
  if(!box) return;
  box.innerHTML = '';
  const ta = document.createElement('textarea');
  ta.className = 'edit';
  ta.value = m.text;
  const bar = document.createElement('div');
  bar.className = 'editbar';
  const ok = document.createElement('button'); ok.className = 'primary'; ok.textContent = '保存';
  const cancel = document.createElement('button'); cancel.textContent = '取消';
  ok.onclick = async ()=>{
    const text = ta.value.trim();
    if(!text){ alert('内容不能为空'); return; }
    const r = await post('/api/messages/edit', {id:m.id, text});
    if(!r.ok){ alert('改写失败：' + r.error); return; }
    m.text = text; applyMessageUpdate(r.message);
  };
  cancel.onclick = ()=>{ box.textContent = m.text; };
  bar.appendChild(ok); bar.appendChild(cancel);
  box.appendChild(ta); box.appendChild(bar);
  ta.focus();
}

function applyMessageUpdate(m){
  const i = msgs.findIndex(x=>x.id === m.id);
  if(i >= 0) msgs[i] = m;
  const node = log.querySelector(`[data-id="${m.id}"]`);
  if(!node) return;
  const body = node.querySelector('.body');
  if(body) body.textContent = m.text; else node.textContent = m.text;
}

function applyMessageDelete(id){
  msgs = msgs.filter(x=>x.id !== id);
  const node = log.querySelector(`[data-id="${id}"]`);
  if(node) node.remove();
}

function atBottom(){ return log.scrollHeight - log.scrollTop - log.clientHeight < 40; }

/* ---------- 跟随滚动：用户一动滚轮就暂停，绝不抢滚动条 ---------- */
let followPaused = false;     // 用户往上滚过 → 暂停自动跟随
let autoScrolling = false;    // 标记程序自己的那次滚动，避免误判成用户操作

function scrollLogToBottom(){
  autoScrolling = true;
  log.scrollTop = log.scrollHeight;
}

function followWanted(){
  return document.getElementById('followState').checked && !followPaused;
}

log.addEventListener('wheel', e=>{
  if(e.deltaY < 0 && !atBottom()){
    followPaused = true;      // 只要往上滚，立刻交还滚动控制权
    pillOn = true;
    renderStatus();
  }
});

log.addEventListener('touchmove', ()=>{
  if(!atBottom()){
    followPaused = true;
    pillOn = true;
    renderStatus();
  }
}, {passive:true});
function jumpBottom(){
  followPaused = false;
  scrollLogToBottom();
  pillOn = false;
  const pill = document.getElementById('newPill');
  if(pill) pill.style.display = 'none';
  renderStatus();
}

function handleMessage(m){
  msgs.push(m);
  if(m.kind === 'reply' || m.kind === 'error' || m.kind === 'perm') clearStream(m.sender);
  if(m.sender && m.kind === 'reply'){
    const a = agents.find(x=>x.name===m.sender);
    if(a){ a.sent = (a.sent||0)+1; a.last_active = m.ts; patchMeta(a); }
  }
  if(passFilter(m)){
    log.appendChild(nodeFor(m));
    if(followWanted()) scrollLogToBottom();
    else { pillOn = true; }
  } else {
    pillOn = true;
  }
  renderStatus();
}

let renderLimit = 200;      // 一次最多渲染多少条：长会话（默认上限 1000 条）不至于把 DOM 撑爆

function renderTimeline(){
  log.innerHTML = '';
  const filtered = msgs.filter(passFilter);
  const hidden = Math.max(0, filtered.length - renderLimit);
  if(hidden > 0){
    const wrap = document.createElement('div');
    wrap.className = 'sys';
    const btn = document.createElement('button');
    btn.className = 'morebtn';
    btn.textContent = `加载更早的 ${Math.min(hidden, renderLimit)} 条（更早还有 ${hidden} 条）`;
    btn.onclick = ()=>{ renderLimit += 200; renderTimeline(); };
    wrap.appendChild(btn);
    log.appendChild(wrap);
  }
  filtered.slice(-renderLimit).forEach(m=>log.appendChild(nodeFor(m)));
  // 步骤流节点被 innerHTML='' 清掉了，按 reply 挂回对应消息下面
  turnNodes.forEach(n=>{
    const target = n.dataset.reply && log.querySelector(`[data-id="${n.dataset.reply}"]`);
    if(target) target.parentNode.insertBefore(n, target.nextSibling);
    else log.appendChild(n);
  });
  pillOn = false;
}

/* ---------- 流式输出 ---------- */
function updateStream(agent, state, live){
  let node = log.querySelector(`[data-stream="${agent}"]`);
  if(state === 'running' && live){
    if(!node){
      node = document.createElement('div');
      node.dataset.stream = agent;
      node.className = kindClass({sender: agent, kind: 'reply'}) + ' streaming';
      node.innerHTML = `<div class="hd"><span class="who">${esc(labelOf(agent))}</span>`
        + `<span class="chip typing">输出中…</span></div><div class="body"></div>`;
      log.appendChild(node);
    } else if(node.nextSibling){
      log.appendChild(node);            // 保持在最下方
    }
    const body = node.querySelector('.body');
    if(body && body.textContent !== live) body.textContent = live;
    if(followWanted()) scrollLogToBottom();
    else if(!followPaused) pillOn = true;
  } else if(node){
    node.remove();
  }
}

function clearStream(agent){
  const node = log.querySelector(`[data-stream="${agent}"]`);
  if(node) node.remove();
}

/* ---------- 成员卡片 ---------- */
function patchMeta(a){
  const el = document.querySelector(`.agent[data-name="${a.name}"] .meta`);
  if(!el) return;
  const run = a.running_since ? `运行中（开始于 ${hhmmss(a.running_since)}）` : (a.session ? String(a.session).slice(0,24) : '未开始');
  const mem = a.native_memory ? '原生记忆' : '窗口记忆';
  el.textContent = `${run} · 发 ${a.sent||0} / 收 ${a.received||0} · 最近 ${hhmmss(a.last_active)} · ${mem}`;
}

function patchDot(a, state){
  const el = document.querySelector(`.agent[data-name="${a.name}"] .dot`);
  if(el) el.className = 'dot ' + (state === 'running' ? 'run' : (a.enabled ? 'on' : 'off'));
  const btn = document.querySelector(`.agent[data-name="${a.name}"] button[data-act="interrupt"]`);
  if(btn) btn.style.display = state === 'running' ? '' : 'none';
}

function renderAgents(){
  const box = document.getElementById('agents');
  box.innerHTML = '';
  agents.forEach(a=>{
    const el = document.createElement('div');
    el.className = 'box agent' + (target === a.name ? ' active' : '');
    el.dataset.name = a.name;
    el.innerHTML = `<div class="row">
        <span class="dot ${a.running_since ? 'run' : (a.enabled ? 'on' : 'off')}"></span>
        <span class="name">${esc(a.label)}</span>
        <span class="kind">${esc(a.kind)}</span>
      </div>
      <div class="meta"></div>`;
    const ops = document.createElement('div');
    ops.className = 'ops';
    const mk = (text, cls, fn, act) => {
      const b = document.createElement('button');
      b.textContent = text;
      if(cls) b.className = cls;
      if(act) b.dataset.act = act;
      b.onclick = async e=>{ e.stopPropagation(); await fn(); };
