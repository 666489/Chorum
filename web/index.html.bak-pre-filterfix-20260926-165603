log.addEventListener('scroll', ()=>{
  if(autoScrolling){            // 这次是程序自己滚的，不算用户操作
    autoScrolling = false;
    return;
  }
  if(atBottom()){
    followPaused = false;       // 用户滚回底部 → 恢复跟随
    pillOn = false;
    const pill = document.getElementById('newPill');
    if(pill) pill.style.display = 'none';
    renderStatus();
  }
});
log.addEventListener('click', async e=>{
  const el = e.target;
  if(!el || !el.getAttribute) return;
  // --- 步骤详情（§27）：先处理，别落到下面的消息按钮分支 ---
  const copyText = el.getAttribute('data-copy');
  if(copyText !== null){
    try{
      await navigator.clipboard.writeText(copyText);
      el.textContent = '已复制';
      setTimeout(()=>{ el.textContent = '复制'; }, 1200);
    }catch(err){ alert(copyText); }          // 剪贴板被拒时至少让用户能手工复制
    return;
  }
  const filePath = el.getAttribute('data-file');
  if(filePath){
    const row = el.closest('[data-step]');
    const id = row ? parseInt(row.dataset.step, 10) : NaN;
    if(!isNaN(id)) await showFile(id, filePath, 0);
    return;
  }
  // 点行本身切换展开；点面板内部不切换（否则看 diff 时会被自己点回去）
  const stepRow = el.closest('.tstep.hasdetail');
  if(stepRow && !el.closest('.detail')){
    const id = parseInt(stepRow.dataset.step, 10);
    if(!isNaN(id)){
      if(openSteps.has(id)) openSteps.delete(id); else openSteps.add(id);
      repaintStep(id);
    }
    return;
  }
  const retryId = el.getAttribute('data-retry');
  if(retryId){
    const r = await post('/api/retry', {message_id: parseInt(retryId,10)});
    if(!r.ok) alert('重试失败：' + r.error);
    return;
  }
  const editId = el.getAttribute('data-edit');
  if(editId){
    const m = msgs.find(x=>x.id === parseInt(editId,10));
    const node = log.querySelector(`[data-id="${editId}"]`);
    if(m && node) startEdit(node, m);
    return;
  }
  const hlId = el.getAttribute('data-hl');
  if(hlId){
    const r = await post('/api/messages/highlight', {id: parseInt(hlId,10), on: true});
    if(!r.ok){ alert('操作失败：' + r.error); return; }
    applyMessageHighlight(r.message);
    return;
  }
  const delId = el.getAttribute('data-del');
  if(delId){
    if(!confirm('删除这条消息？删除后模型下一轮起看不到它。')) return;
    const r = await post('/api/messages/delete', {id: parseInt(delId,10)});
    if(!r.ok){ alert('删除失败：' + r.error); return; }
    applyMessageDelete(parseInt(delId,10));
    return;
  }
  const okId = el.getAttribute('data-perm-ok');
  const noId = el.getAttribute('data-perm-no');
  if(okId || noId){
    const r = await post('/api/perms/resolve', {id: parseInt(okId || noId, 10), approve: !!okId});
    if(!r.ok){ alert('操作失败：' + r.error); return; }
    await loadAgents();
  }
});
document.addEventListener('keydown', e=>{
  if((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')){
    e.preventDefault();
    setCollapsed(!sidebar.classList.contains('hidden'));
  }
  if(e.key === 'Escape'){
    const busy = agents.some(a=>a.running_since) || ((healthCache || {}).running || []).length > 0;
    if(busy){ e.preventDefault(); stopAllRuns(); }   // Esc = 停止键
  }
});

/* 鼠标选中文字 → 浮动「高亮选中」 */
const selBar = document.getElementById('selBar');
let pendingSel = null;
const hideSelBar = ()=>{ selBar.style.display = 'none'; };
document.addEventListener('mouseup', ev=>{
  if(ev.target && ev.target.closest && ev.target.closest('#selBar')) return;
  const sel = window.getSelection();
  if(!sel || sel.isCollapsed || !sel.toString().trim()){ hideSelBar(); return; }
  const range = sel.getRangeAt(0);
  let node = range.commonAncestorContainer;
  if(node.nodeType !== 1) node = node.parentElement;
  const body = node && node.closest ? node.closest('.body') : null;
  const bubble = body && body.closest ? body.closest('.msg') : null;
  if(!body || !bubble){ hideSelBar(); return; }
  const id = parseInt(bubble.dataset.id, 10);
  const m = msgs.find(x=>x.id === id);
  if(!m){ hideSelBar(); return; }
  const pre = document.createRange();
  pre.selectNodeContents(body);
  pre.setEnd(range.startContainer, range.startOffset);
  const start = pre.toString().length;
  const end = start + sel.toString().length;
  if(end <= start){ hideSelBar(); return; }
  pendingSel = { id, start, end };
  document.getElementById('selHlClear').style.display = m.highlight ? '' : 'none';
  hideHlBar();                                    // 选区浮条出现时，收起高亮浮条，避免叠在一起
  const rect = range.getBoundingClientRect();
  selBar.style.display = 'flex';
  selBar.style.left = Math.max(6, Math.min(window.innerWidth - 230, rect.left + rect.width / 2 - 90)) + 'px';
  selBar.style.top = Math.max(6, rect.top - 38) + 'px';
});
document.addEventListener('mousedown', e=>{
  if(!(e.target && e.target.closest && e.target.closest('#selBar'))) hideSelBar();
});
log.addEventListener('scroll', hideSelBar);
/* 「清除本条高亮」：鼠标移到高亮处时，在光标位置浮现并停住，方便直接点它 */
const hlBar = document.getElementById('hlBar');
let hlTargetId = null;
let hlShownFor = null;   // 当前浮条属于哪一条消息
function hideHlBar(){ hlBar.style.display = 'none'; hlTargetId = null; hlShownFor = null; }
function showHlBar(x, y){
  hlBar.style.display = 'flex';
  hlBar.style.left = Math.min(window.innerWidth - 150, x + 6) + 'px';
  hlBar.style.top = Math.min(window.innerHeight - 36, y + 10) + 'px';
}
document.addEventListener('mousemove', e=>{
  const t = e.target;
  if(!t || !t.closest) return;
  if(t.closest('#hlBar')) return;                 // 指针在浮条上，保持显示
  const inside = t.closest('.msg, .sys');
  const insideId = inside ? parseInt(inside.dataset.id, 10) : null;
  if(hlShownFor !== null && insideId === hlShownFor) return;  // 还在同一条里：位置不动
  const seg = t.closest('.hlseg');
  const bubble = seg ? seg.closest('.msg') : t.closest('.msg.hl, .sys.hl');
  if(!bubble){ hideHlBar(); return; }
  hlTargetId = parseInt(bubble.dataset.id, 10);
  hlShownFor = hlTargetId;
  showHlBar(e.clientX, e.clientY);                // 只在“刚进入高亮”这一刻定位
});
log.addEventListener('scroll', hideHlBar);
document.getElementById('hlClear').onclick = async ()=>{
  if(!hlTargetId) return;
  const id = hlTargetId;
  hideHlBar();
  const r = await post('/api/messages/highlight', {id, on:false});
  if(!r.ok){ alert('操作失败：' + r.error); return; }
  applyMessageHighlight(r.message);
};
document.getElementById('selHl').onclick = async ()=>{
  if(!pendingSel) return;
  const r = await post('/api/messages/highlight', {...pendingSel, on:true});
  hideSelBar();
  if(!r.ok){ alert('高亮失败：' + r.error); return; }
  applyMessageHighlight(r.message);
  const s = window.getSelection();
  if(s) s.removeAllRanges();
};
document.getElementById('selHlClear').onclick = async ()=>{
  if(!pendingSel) return;
  const r = await post('/api/messages/highlight', {id: pendingSel.id, on:false});
  hideSelBar();
  if(!r.ok){ alert('操作失败：' + r.error); return; }
  applyMessageHighlight(r.message);
};

