    t1.innerHTML = `<input type="checkbox" ${a.enabled?'checked':''}/> 参与全体`;
    t1.querySelector('input').onchange = async e=>{
      e.stopPropagation();
      await post('/api/agents/toggle', {agent:a.name, enabled:e.target.checked});
      await loadAgents();
    };
    const t2 = document.createElement('label'); t2.className = 'chk';
    t2.innerHTML = `<input type="checkbox" ${a.relay?'checked':''}/> 自动接力`;
    t2.querySelector('input').onchange = async e=>{
      e.stopPropagation();
      await post('/api/agents/relay', {agent:a.name, enabled:e.target.checked});
      await loadAgents();
    };
    ops.appendChild(t1); ops.appendChild(t2);
    if(a.kind === 'cli'){
      const t3 = document.createElement('label');
      t3.className = 'chk';
      t3.title = '不勾=上下文由窗口掌管，删改消息立即生效；勾=用 CLI 自己的会话记忆，删改不影响它';
      t3.innerHTML = `<input type="checkbox" ${a.native_memory?'checked':''}/> 原生记忆`;
      t3.querySelector('input').onchange = async e=>{
