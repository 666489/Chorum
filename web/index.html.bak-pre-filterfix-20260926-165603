/* ---------- 执行流程步骤流（trace，§19.1；**纯 append，不轮询**） ---------- */
const turnNodes = new Map();     // turn_id -> 步骤流容器
const turnAgents = new Map();    // turn_id -> agent
const stepEls = new Map();       // step.id -> 行元素
const stepCache = new Map();     // step.id -> 最近一次 step 载荷（重渲染用）

// 工具名白名单。codex app-server 是 camelCase（commandExecution / fileChange）、
// 旧版是 snake_case，claude/codebuddy 是小写单词 —— 三套都要能落到同一行文案，
// 否则 codex 那行会顶出「已调用 commandExecution」而不是截图里的「>- 已运行」。
const TOOL_EDIT = /^(edit|write|multiedit|str_replace|apply_patch|applypatch|notebookedit|patch|filechange|file_change)$/i;
const TOOL_RUN  = /^(bash|shell|command|exec|run|terminal|commandexecution|command_execution|local_shell|localshell)$/i;
const TOOL_READ = /^(read|read_file|readfile|view|glob|grep|search|web_search|websearch)$/i;

function stepDetail(st){
  if(!st || !st.detail) return {};
  try{ return (typeof st.detail === 'string') ? JSON.parse(st.detail) : st.detail; }
  catch(e){ return {raw: st.detail}; }
}

function stepInput(st){
  const d = stepDetail(st);
  return d.input || d || {};
}

function basename(p){
  if(!p) return '';
  return p.replace(/[\\/]/g, '/').split('/').pop();
}

function stepFileHint(st){
  const inp = stepInput(st);
  const p = inp.file_path || inp.path || inp.filePath || '';
  return p && /[\\/]/.test(p) ? ` ${basename(p)}` : '';
}

function stepLabel(st){
  const name = st.name || '';
  const kind = st.kind;
  const running = st.status === 'running';
  const hint = stepFileHint(st);
  if(kind === 'llm_call'){
    return running ? ['>-', '正在思考']
                   : ['>-', st.in_tokens ? `已思考 ${st.in_tokens} tokens` : '已思考'];
  }
  if(kind === 'tool_call'){
    if(st.status === 'error')   return ['✕', `${name || '工具'} 失败`];
    if(running)                 return ['>-', `${name || '工具'} 正在运行${hint}`];
    if(TOOL_EDIT.test(name))    return ['✎', `已编辑${hint}`];
    if(TOOL_RUN.test(name))     return ['>-', `已运行${hint}`];
    if(TOOL_READ.test(name))    return ['▤', `已读取${hint}`];
    return ['>-', `已调用 ${name || '工具'}${hint}`];
  }
  if(kind === 'tool_result') return ['↳', '结果'];
  if(kind === 'thinking')    return ['…', '思考'];
  if(kind === 'text')        return ['─', '输出'];
  if(kind === 'note')        return ['·', st.name || '备注'];
  return ['·', kind || '步骤'];
}

function durText(st){
  if(!st.start_ts) return '';
  const ms = (st.end_ts || Date.now()) - st.start_ts;
  if(ms < 500) return '';
  return ms >= 1000 ? (ms/1000).toFixed(1) + 's' : ms + 'ms';
}

function openFile(p){
  if(!p) return;
  const uri = 'vscode://file/' + p.replace(/\\/g, '/');
  const a = document.createElement('a');
  a.href = uri; a.target = '_blank'; document.body.appendChild(a); a.click(); a.remove();
}

function diffHtml(oldStr, newStr){
  const oldLines = (oldStr === undefined || oldStr === null) ? [] : String(oldStr).split('\n');
  const newLines = (newStr === undefined || newStr === null) ? [] : String(newStr).split('\n');
  let html = '';
  for(const l of oldLines) html += `<span class="diffline diffdel">- ${esc(l)}</span>`;
  for(const l of newLines) html += `<span class="diffline diffadd">+ ${esc(l)}</span>`;
  if(!html) html = '<span class="diffline diffctx">（无文本变化）</span>';
  return {html, stats: `+${newLines.length} -${oldLines.length}`};
}

function renderStepDetail(st){
  const d = stepDetail(st);
  const inp = stepInput(st);
  const filePath = inp.file_path || inp.path || inp.filePath || '';
  const cmd = inp.command || inp.cmd || inp.shell || '';
  const oldStr = inp.old_string !== undefined ? inp.old_string : (inp.oldString !== undefined ? inp.oldString : undefined);
  const newStr = inp.new_string !== undefined ? inp.new_string : (inp.newString !== undefined ? inp.newString : (inp.content !== undefined ? inp.content : undefined));

  if(filePath && (oldStr !== undefined || newStr !== undefined)){
    const {html, stats} = diffHtml(oldStr, newStr);
    return `<div class="dpath">${fileLink(filePath)}<span class="diffstat">${esc(stats)}</span></div>${html}`;
  }
  if(filePath && TOOL_READ.test(st.name || '')){
    return `<div class="dpath">${fileLink(filePath)}<span class="diffstat">已读取</span></div>`;
  }
  if(cmd){
    const out = d.content || d.output || d.stdout || '';
    const err = d.stderr || '';
    let outHtml = '';
    if(out || err){
      outHtml = `<div class="cmdout">${esc(out)}${err ? '<span class="diffdel">'+esc(err)+'</span>' : ''}</div>`;
    }
    return `<div class="cmdlbl">Shell</div><div class="cmdline">${esc(cmd)}</div>${outHtml}`;
  }
  if(filePath){
    return `<div class="dpath">${fileLink(filePath)}</div><div class="rawjson">${esc(JSON.stringify(inp, null, 2))}</div>`;
  }
  if(Object.keys(d).length){
    return `<div class="rawjson">${esc(JSON.stringify(d, null, 2))}</div>`;
  }
  return '';
}

function turnNode(turnId, agent){
  let n = turnNodes.get(turnId);
  if(!n){
    n = document.createElement('div');
    n.className = 'tracesteps';
    n.dataset.turn = turnId;
    n.innerHTML = `<div class="thd"><span class="twho">${esc(labelOf(agent))}</span>`
      + `<span class="tchip">执行流程</span></div><div class="tbody"></div>`;
    log.appendChild(n);
    turnNodes.set(turnId, n);
    if(agent) turnAgents.set(turnId, agent);
  }
  return n;
}

/* ---------- 步骤详情：diff 红绿 / Shell 块 / 文件直链（§27） ----------
   数据全部来自 step.detail（tool_call 的入参，按字段截断后的 JSON）。
   展开状态另存在 openSteps —— upsertStep 每次 SSE 都会重渲染 innerHTML，
   不另存的话面板会在下一条事件到达时自己合上。 */
const openSteps = new Set();     // step.id，展开中
const fileViews = new Map();     // step.id -> {path, line, text} | {path, error}

function detailOf(st){
  if(!st || !st.detail) return null;
  try{
    const d = JSON.parse(st.detail);
    if(d && typeof d === 'object' && Object.keys(d).length) return d;
  }catch(e){ /* 非 JSON 的旧数据：不展开，别炸 */ }
  return null;
}

function hasDetail(st){
  const d = detailOf(st);
  return !!(d && (d.path || d.command || d.old_text || d.new_text
                  || d.diff_text || d.output || d.clipped));
}

function fileLink(path){
  const name = String(path).split(/[\\/]/).pop();
  return `<a class="filelink" data-file="${esc(path)}" title="${esc(path)}">${esc(name)}</a>`;
}

function lineCount(s){
  return s ? String(s).replace(/\n$/, '').split('\n').length : 0;
}

function diffStat(oldText, newText){
  return `<span class="plus">+${lineCount(newText)}</span> `
       + `<span class="minus">-${lineCount(oldText)}</span>`;
}

// claude 侧只给 old/new（没有文件上下文），就按「整段删 → 整段增」渲染
function oldNewDiff(oldText, newText){
  let h = '';
  if(oldText) String(oldText).replace(/\n$/, '').split('\n').forEach(l=>{
    h += `<span class="diffline diffdel">- ${esc(l)}</span>`;
  });
  if(newText) String(newText).replace(/\n$/, '').split('\n').forEach(l=>{
    h += `<span class="diffline diffadd">+ ${esc(l)}</span>`;
  });
  return h;
}

// codex 的 fileChange 给的是统一 diff（带 @@ 段号），按行首上色即可
function unifiedDiff(text){
  return String(text).split('\n').map(l=>{
    let cls = 'diffctx';
    if(l.startsWith('@@') || l.startsWith('+++') || l.startsWith('---')) cls = 'diffctx';
    else if(l.startsWith('+')) cls = 'diffadd';
    else if(l.startsWith('-')) cls = 'diffdel';
    return `<span class="diffline ${cls}">${esc(l) || '&nbsp;'}</span>`;
  }).join('');
}

function numberedText(view){
  return String(view.text).split('\n').map((l, i)=>{
    const n = i + 1;
    const hit = (view.line && n === view.line)
      ? ' style="background:rgba(59,130,246,.18)"' : '';
    return `<span class="diffline diffctx"${hit}>${String(n).padStart(4, ' ')} │ ${esc(l)}</span>`;
  }).join('');
}

function renderDetail(st){
  const d = detailOf(st) || {};
  const view = fileViews.get(st.id);
  if(!Object.keys(d).length && !view) return '';
  let h = '';
  const stat = (d.old_text || d.new_text) ? ` ${diffStat(d.old_text, d.new_text)}` : '';
  if(d.path){
    h += `<div class="dpath">${fileLink(d.path)}`
       + (stat ? `<span class="diffstat">${stat}</span>` : '')
       + (d.files > 1 ? `<span class="diffstat">等 ${d.files} 个文件</span>` : '')
       + (d.clipped ? `<span class="diffstat">内容已截断，点文件名看全文</span>` : '')
       + `</div>`;
  }else if(stat){
    h += `<div class="dpath"><span class="diffstat">${stat}</span></div>`;
  }
  const body = d.diff_text ? unifiedDiff(d.diff_text)
             : (d.old_text || d.new_text) ? oldNewDiff(d.old_text, d.new_text) : '';
  if(body) h += `<div class="diffwrap">${body}</div>`;
  if(d.command){
    h += `<div class="cmdlbl">Shell<span class="copybtn" data-copy="${esc(d.command)}">复制</span></div>`
       + `<div class="cmdline">$ ${esc(d.command)}</div>`;
  }
  if(d.pattern || d.query){
    h += `<div class="cmdlbl">参数</div><div class="cmdline">${esc(d.pattern || d.query)}</div>`;
  }
  if(d.output) h += `<div class="cmdlbl">输出</div><div class="cmdout">${esc(d.output)}</div>`;
  if(view){
    h += `<div class="filehead">${esc(view.path)}</div>`;
    h += view.error ? `<div class="cmdout">${esc(view.error)}</div>`
                    : `<div class="cmdout">${numberedText(view)}</div>`;
  }
  return h ? `<div class="detail">${h}</div>` : '';
}

async function showFile(stepId, path, line){
  try{
    const r = await (await fetch('/api/file?path=' + encodeURIComponent(path)
                                 + '&line=' + (line || 0))).json();
    fileViews.set(stepId, r && r.ok ? {path: r.path, line: r.line, text: r.text}
                                    : {path: path, error: '读取失败：' + ((r && r.error) || '未知错误')});
  }catch(e){
    fileViews.set(stepId, {path: path, error: '读取失败：' + e.message});
  }
  if(stepEls.get(stepId)){
    openSteps.add(stepId);
    repaintStep(stepId);
  }
}

function repaintStep(stepId){
  const node = stepEls.get(stepId);
  if(!node) return;
  const st = stepCache.get(stepId);
  if(!st) return;
  const [icon, text] = stepLabel(st);
  const det = hasDetail(st) || fileViews.has(stepId);
  node.className = 'tstep ' + (st.status || 'ok')
    + (det ? ' hasdetail' : '') + (openSteps.has(stepId) ? ' open' : '');
  node.innerHTML = `<span class="ico">${esc(icon)}</span><span class="lb">${esc(text)}</span>`
    + `<span class="dur">${esc(durText(st))}</span>` + renderDetail(st);
}

function upsertStep(turnId, st){
  if(!turnId || !st || st.id == null) return;
  const box = turnNode(turnId, turnAgents.get(turnId));
  const body = box.querySelector('.tbody');
  let el = stepEls.get(st.id);
  if(!el){
    el = document.createElement('div');
    body.appendChild(el);
    stepEls.set(st.id, el);
  }
  stepCache.set(st.id, st);
  el.dataset.step = st.id;
  repaintStep(st.id);
  if(followWanted()) scrollLogToBottom();
}

function endTurn(t){
  const n = turnNodes.get(t.id);
  if(!n) return;
  n.dataset.status = t.status || 'ok';
  const chip = n.querySelector('.tchip');
  if(chip){
    chip.textContent = t.status === 'ok' ? '流程完成'
      : t.status === 'interrupted' ? '已中断'
      : t.status === 'timeout' ? '超时' : '出错';
  }
  // 回复已落库就贴到它下面（用户截图的位置）
  if(t.reply_msg_id){
    n.dataset.reply = t.reply_msg_id;
    const target = log.querySelector(`[data-id="${t.reply_msg_id}"]`);
    if(target && target.nextSibling !== n) target.parentNode.insertBefore(n, target.nextSibling);
  }
}

function clearTrace(){
  turnNodes.clear(); turnAgents.clear(); stepEls.clear();
  stepCache.clear(); openSteps.clear(); fileViews.clear();
  log.querySelectorAll('.tracesteps').forEach(n=>n.remove());
}

/* trace_reset：清空本地 store 后**必须重拉**，否则留永久空洞（§7.5） */
async function reloadTrace(){
  clearTrace();
  try{
    const list = (await (await fetch('/api/trace')).json()).traces || [];
    for(const t of list.slice(0, 20)){
      const d = await (await fetch('/api/trace/' + t.trace_id)).json();
      for(const turn of (d.turns || [])){
        turnNode(turn.id, turn.agent);
        (d.steps || {})[turn.id] && (d.steps[turn.id] || []).forEach(st=>upsertStep(turn.id, st));
        endTurn(turn);
      }
    }
  }catch(e){ /* 重拉失败不阻塞 */ }
}

function connect(){
  if(es){ try{ es.close(); }catch(e){} }
  es = new EventSource('/api/stream');
  es.onopen = ()=>{ document.getElementById('conn').textContent = '已连接'; document.getElementById('banner').classList.remove('show'); renderStatus(); };
  es.onerror = ()=>{ document.getElementById('conn').textContent = '已断开'; document.getElementById('banner').classList.add('show'); renderStatus(); };
  es.onmessage = async ev=>{
    const data = JSON.parse(ev.data);
    if(data.type === 'message') handleMessage(data.message);
    else if(data.type === 'status'){
      const a = agents.find(x=>x.name===data.agent);
      if(a){ a.running_since = data.state === 'running' ? (a.running_since || Date.now()/1000) : null; patchDot(a, data.state); patchMeta(a); }
      updateStream(data.agent, data.state, data.live);
      if(healthCache){
        const set = new Set((healthCache.running||[]).map(r=>r.agent));
        data.state === 'running' ? set.add(data.agent) : set.delete(data.agent);
        healthCache.running = [...set].map(name=>({agent:name, label:labelOf(name)}));
        renderStatus();
      }
    }
    else if(data.type === 'relay'){ document.getElementById('relayState').checked = data.relay; renderStatus(); }
    else if(data.type === 'cleared'){ applyCleared(); }
    else if(data.type === 'message_updated'){ applyMessageUpdate(data.message); }
    else if(data.type === 'message_highlighted'){ applyMessageHighlight(data.message); }
    else if(data.type === 'message_deleted'){ applyMessageDelete(data.id); }
    else if(data.type === 'context'){ document.getElementById('shareBox').value = data.context || ''; }
    else if(data.type === 'agents'){ await loadAgents(); }
    else if(data.type === 'perms'){ await loadPerms(); }
    else if(data.type === 'turn_started'){ const t = data.turn || {}; if(t.id) turnNode(t.id, t.agent); }
    else if(data.type === 'step'){ const st = data.step || {}; upsertStep(data.turn_id || st.turn_id, st); }
    else if(data.type === 'turn_ended'){ if(data.turn) endTurn(data.turn); }
    else if(data.type === 'trace_reset'){ await reloadTrace(); }
  };
}

async function send(){
  const ta = document.getElementById('text');
  const text = ta.value.trim();
  if(!text && !pendingAtts.length) return;
  ta.value = '';
  document.getElementById('send').disabled = true;
  const j = await post('/api/send', {text, target, attachments: pendingAtts.map(a=>a.id)});
  document.getElementById('send').disabled = false;
  ta.focus();
  if(!j.ok){ alert('发送失败：' + j.error); return; }
  pendingAtts = [];
  renderAtts();
}

