<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>多智能体群聊 · 统一窗口</title>
<style>
  :root{
    --bg:#0f1115; --panel:#171a21; --panel2:#1e222b; --line:#2a2f3a;
    --bar:#12151b; --text:#e6e8ee; --muted:#98a0b3; --user:#2563eb;
    --claude:#d97757; --codex:#10a37f; --codebuddy:#7c6cf6; --dsh:#4d6bfe; --mirror:#5b6474;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{margin:0;font:14px/1.6 -apple-system,"Segoe UI","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);display:flex;flex-direction:column;overflow:hidden}
  #shell{flex:1;display:flex;min-height:0}

  /* ---------- 活动栏（VSCode 风格） ---------- */
  #activity{width:46px;flex:0 0 46px;background:var(--bar);border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;padding:6px 0;gap:2px}
  /* 会话面板（左侧第一块，由活动栏的「会话」图标开合）：形制参考 DeepSeek 的会话列表 */
  section[data-panel="conv"] button#cvNew{width:100%;background:#232936;color:var(--text);
    border:1px solid var(--line);border-radius:8px;padding:7px 8px;font-size:12.5px;cursor:pointer}
  section[data-panel="conv"] button#cvNew:hover{border-color:#3b82f6;color:#fff}
  #cvList{flex:1;overflow:auto;padding:2px 8px 12px}
  .cv-group{font-size:11px;color:#6b7686;padding:10px 4px 4px}
  .cv-item{display:flex;align-items:center;gap:4px;padding:5px 6px;border-radius:7px;cursor:pointer;font-size:12.5px}
  .cv-item:hover{background:#1e2430}
  .cv-item.on{background:#2a3142;color:#fff}
  .cv-item .t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .cv-item .pin{color:#f5c26b;font-size:10px}
  .cv-item .more{opacity:0;background:none;border:0;color:var(--muted);cursor:pointer;font-size:13px;padding:0 3px}
  .cv-item:hover .more{opacity:1}
  .cv-item .more:hover{color:#fff}
  .cv-menu{position:fixed;z-index:40;background:#1b202b;border:1px solid var(--line);border-radius:8px;
    padding:4px;box-shadow:0 6px 18px rgba(0,0,0,.5);font-size:12px}
  .cv-menu button{display:block;width:100%;text-align:left;background:none;border:0;color:var(--text);
    padding:5px 10px;border-radius:6px;cursor:pointer;font-size:12px}
  .cv-menu button:hover{background:#2a3142}
  .cv-menu button.danger{color:#fca5a5}
  #activity .act{width:46px;height:44px;display:flex;align-items:center;justify-content:center;background:none;border:0;cursor:pointer;color:var(--muted);position:relative;padding:0}
  #activity .act svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  #activity .act:hover{color:var(--text)}
  #activity .act.on{color:#fff}
  #activity .act.on::before{content:"";position:absolute;left:0;top:8px;bottom:8px;width:2px;background:#fff;border-radius:0 2px 2px 0}
  #activity .spacer{flex:1}
  #activity .act[data-act="collapse"] svg{transition:transform .15s ease}
  #activity.collapsed .act[data-act="collapse"] svg{transform:rotate(180deg)}

  /* ---------- 侧边栏 ---------- */
  #sidebar{width:300px;flex:0 0 300px;background:var(--panel);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow:auto;padding:12px;gap:10px}
  #sidebar.hidden{display:none}
  .panel{display:none;flex-direction:column;gap:10px}
  .panel.on{display:flex}
  .panel h2{font-size:12px;color:var(--muted);margin:0;font-weight:600;letter-spacing:.3px}
  .box{border:1px solid var(--line);border-radius:10px;padding:9px 10px;background:var(--panel2)}
  .box h3{margin:0 0 6px;font-size:12px;color:var(--muted);font-weight:600}
  .agent{margin-bottom:8px}
  .agent.active{border-color:#3b82f6;box-shadow:0 0 0 1px #3b82f6 inset}
  .agent .row{display:flex;align-items:center;gap:8px}
  .dot{width:8px;height:8px;border-radius:50%;background:#4b5563;flex:0 0 8px}
  .dot.run{background:#f59e0b}
  .dot.on{background:#22c55e}
  .agent .name{font-weight:600;cursor:pointer}
  .agent .kind{margin-left:auto;font-size:10px;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:0 6px}
  .agent .meta{color:var(--muted);font-size:11px;margin-top:3px;word-break:break-all}
  .agent .ops{display:flex;gap:6px;margin-top:7px;flex-wrap:wrap}
  .agent button,.agent label.chk,.box button,.tt button,label.chk{font-size:11px;background:#232936;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:3px 8px;cursor:pointer}
  .agent button:hover,.box button:hover,.tt button:hover{color:#fff}
  .agent button.danger:hover{color:#fca5a5;border-color:#7f1d1d}
  .agent label.chk,label.chk{display:flex;align-items:center;gap:4px}
  #addModel{width:100%;background:#1d4ed8;border:0;color:#fff;border-radius:8px;padding:8px;cursor:pointer}
  .kv{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);padding:1px 0;gap:8px}
  .kv b{color:var(--text);font-weight:600;text-align:right;word-break:break-all}
  .row2{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap}
  textarea.share{width:100%;height:130px;resize:vertical;background:#11141a;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:7px 9px;font:inherit;font-size:12px}
  .tt{display:flex;gap:6px;align-items:center;flex-wrap:wrap;font-size:12px}
  .tt input[type=text],.tt select{background:#11141a;color:var(--text);border:1px solid var(--line);border-radius:6px;padding:4px 8px;font:inherit;font-size:12px;width:100%}

  /* ---------- 主区 ---------- */
  main{flex:1;display:flex;flex-direction:column;min-width:0}
  header{padding:9px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;background:var(--panel);flex-wrap:wrap}
  header .title{font-weight:600}
  header button{background:#232936;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:4px 10px;font-size:12px;cursor:pointer}
  header button:hover{color:#fff}
  #shutdown{color:#fca5a5}
  #shutdown:hover{color:#fff;border-color:#7f1d1d}
  #shutdown:disabled{color:var(--muted)}
  header .conn{margin-left:auto;font-size:12px;color:var(--muted)}
  .banner{display:none;background:#3b1d1d;border-bottom:1px solid #7f1d1d;color:#fca5a5;padding:6px 14px;font-size:12px;align-items:center;gap:10px}
  .banner.show{display:flex}
  #log{flex:1;overflow:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
  .msg{max-width:min(820px,86%);border:1px solid var(--line);background:var(--panel2);border-radius:12px;padding:9px 12px;white-space:pre-wrap;word-break:break-word}
  .msg .hd{font-size:11px;color:var(--muted);margin-bottom:4px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .msg .who{font-weight:600;font-size:12px}
  .msg .body{white-space:pre-wrap;word-break:break-word}
  /* 消息操作：与「XX 开始处理」状态文字同字号同颜色 */
  .msg .hd button,.sys button{
    font:inherit;font-size:12px;line-height:1;background:none;border:0;padding:0;margin-left:2px;
    color:var(--muted);cursor:pointer;opacity:0;pointer-events:none;transition:opacity .12s ease;
  }
  /* 改写 / 删除 / 整条高亮 / 重试：鼠标移入该条即出现 */
  .msg:hover .hd button,.msg:focus-within .hd button,
  .sys:hover button,.sys:focus-within button{opacity:1;pointer-events:auto}
  .msg .hd button:hover,.sys button:hover{color:#fca5a5;text-decoration:underline}
  .edit{width:100%;min-height:70px;background:#11141a;color:var(--text);border:1px solid #3b82f6;border-radius:8px;padding:7px 9px;font:inherit;resize:vertical}
  .editbar{display:flex;gap:6px;margin-top:6px}
  .editbar button{font-size:11px;background:#232936;color:var(--text);border:1px solid var(--line);border-radius:6px;padding:3px 10px;cursor:pointer}
  .editbar button.primary{background:#1d4ed8;border-color:#1d4ed8}
  .msg.user{align-self:flex-end;background:#152647;border-color:#1d3f78}
  .msg.user .who{color:#93c5fd}
  .msg.claude .who{color:var(--claude)} .msg.claude{border-left:3px solid var(--claude)}
  .msg.codex .who{color:var(--codex)} .msg.codex{border-left:3px solid var(--codex)}
  .msg.codebuddy .who{color:var(--codebuddy)} .msg.codebuddy{border-left:3px solid var(--codebuddy)}
  .msg.dsh .who{color:var(--dsh)} .msg.dsh{border-left:3px solid var(--dsh)}
  .msg.model{border-left:3px solid #38bdf8}.msg.model .who{color:#38bdf8}
  .msg.claudelink{border-left:3px solid var(--mirror);opacity:.85;font-size:13px}
  .msg.claudelink .who{color:var(--mirror)}
  .msg.error{border-left:3px solid #ef4444}.msg.error .who{color:#ef4444}
  /* 高亮：只给人看的可视化，同时会以 ★重要★ 标注进模型上下文 */
  .msg.hl{box-shadow:0 0 0 1px #b45309 inset;background:#231d13}
  .msg.hl.user{background:#1b2843}
  .msg .hd .star{color:#f59e0b;font-weight:600}
  .msg .hd .tstat.ok{color:#4ade80;border-color:#14532d}
  .msg .hd .tstat.err{color:#fca5a5;border-color:#7f1d1d}
  .msg .hd .tstat.warn{color:#f5c26b;border-color:#7c5a12}
  .msg .errline{color:#fca5a5;font-size:12px;margin:2px 0 4px;white-space:pre-wrap}
  #targets .chip{margin-left:4px;color:#8fa0bd}
  .hlseg{background:rgba(245,158,11,.20);border-bottom:1px solid #b45309;border-radius:2px;padding:0 1px}
  #selBar{position:fixed;display:none;gap:6px;z-index:30;background:#1b202b;border:1px solid var(--line);border-radius:8px;padding:4px 5px;box-shadow:0 6px 18px rgba(0,0,0,.45)}
  #selBar button{font-size:11px;background:none;border:0;color:var(--text);padding:2px 8px;cursor:pointer;border-radius:6px}
  #selBar button:hover{background:#2a3142}
  /* 「清除本条高亮」浮条：鼠标移到高亮处时跟随光标出现 */
  #hlBar{position:fixed;display:none;z-index:31;background:#1b202b;border:1px solid #7c5a12;border-radius:8px;padding:3px 5px;box-shadow:0 6px 18px rgba(0,0,0,.5);pointer-events:auto}
  #hlBar button{font-size:11px;background:none;border:0;color:#f5c26b;padding:2px 8px;cursor:pointer;border-radius:6px;white-space:nowrap}
  #hlBar button:hover{background:#2a3142;color:#ffd79a}
  .sys{align-self:center;color:var(--muted);font-size:12px}
  .morebtn{background:#1b2230;border:1px solid #2a3a55;color:#9fb0c9;border-radius:999px;
           padding:3px 12px;font-size:11.5px;cursor:pointer}
  .morebtn:hover{color:#fff;border-color:#3b82f6}
  /* 执行顺序（发给「全体」时的先后） */
  .dsp{display:flex;flex-direction:column;gap:7px}
  .dsp h3{margin:0;font-size:12.5px;color:var(--text);font-weight:600}
  .dsp select{background:#1b2230;color:var(--text);border:1px solid var(--line);border-radius:6px;
    padding:3px 6px;font-size:11.5px;width:100%}
  .dsp .dsp-note{font-size:11px;color:var(--muted);line-height:1.5}
  .dsp .dsp-item{display:flex;align-items:center;gap:6px;padding:2px 0}
  .dsp .dsp-item .ord{width:16px;color:#8fa0bd;font-size:11px;text-align:right}
  .dsp .dsp-item .who{flex:1;font-size:12.5px}
  .dsp .dsp-item button{background:#232936;color:var(--muted);border:1px solid var(--line);
    border-radius:6px;padding:0 7px;font-size:12px;line-height:19px;cursor:pointer}
  .dsp .dsp-item button:hover:not(:disabled){color:#fff;border-color:#3b82f6}
  .dsp .dsp-item button:disabled{opacity:.35;cursor:default}
  .dsp .dsp-planner{font-size:11.5px;color:var(--muted);display:flex;align-items:center;gap:6px}
  .dsp .dsp-planner select{flex:1}
  .dsp .dsp-note code{background:#1b2230;border-radius:3px;padding:0 3px}
  .chip{border:1px solid var(--line);border-radius:999px;padding:0 6px;font-size:10px;color:var(--muted)}
  footer#composer{background:var(--panel);padding:10px 14px;display:flex;flex-direction:column;gap:8px}
  #targets{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
  #targets button{background:#232936;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:4px 12px;cursor:pointer;font-size:12px}
  #targets button.on{background:#1d4ed8;color:#fff;border-color:#1d4ed8}
  .composer{display:flex;gap:8px;align-items:flex-end}
  #text{flex:1;resize:none;height:64px;background:#11141a;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px 11px;font:inherit}
  #send{background:#1d4ed8;color:#fff;border:0;border-radius:10px;padding:10px 18px;cursor:pointer;height:40px}
  #send:disabled{opacity:.5;cursor:default}
  /* 停止键：与发送键同排的圆形按钮（有轮次在跑时高亮） */
  #stop{width:40px;height:40px;flex:0 0 40px;border-radius:50%;border:1px solid #2a3a55;background:#1b2230;
        display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;transition:.15s}
  #stop svg{width:16px;height:16px;fill:#6b7688}
  #stop.live{background:#2563eb;border-color:#2563eb}
  #stop.live svg{fill:#fff}
  #stop.live:hover{background:#1d4ed8}
  #stop[disabled]{opacity:.45;cursor:default}
  .hint{color:var(--muted);font-size:11px}
  /* 说明栏：整条可点，收起/展开记在本地 */
  .hintbar{display:flex;gap:6px;align-items:flex-start;cursor:pointer;color:var(--muted);font-size:11px;line-height:1.5;user-select:none}
  .hintbar .caret{flex:0 0 auto;width:11px;opacity:.75}
  .hintbar:hover .caret,.hintbar:hover .hintlabel,.hintbar:hover .hint{color:#c9d1e4}
  .hintbar.collapsed .hint{display:none}
  .hintbar .hintlabel{display:inline;color:var(--muted)}
  .hintbar:not(.collapsed) .hintlabel{display:none}

  /* ---------- 底部状态栏 ---------- */
  #status{height:24px;flex:0 0 24px;background:var(--bar);border-top:1px solid var(--line);display:flex;align-items:center;gap:14px;padding:0 12px;font-size:11px;color:var(--muted);overflow:hidden;white-space:nowrap}
  #status .st{display:flex;align-items:center;gap:5px;cursor:pointer;padding:0 2px}
  #status .st:hover{color:#fff}
  #status .st.dot-green::before{content:"●";color:#22c55e;font-size:9px}
  #status .st.dot-red::before{content:"●";color:#ef4444;font-size:9px}
  #status .st.dot-amber::before{content:"●";color:#f59e0b;font-size:9px}
  #status .spacer{flex:1}
  #status .st.off{opacity:.55}
  #newPill{display:none}

  /* ---------- 弹窗 ---------- */
  .mask{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:20}
  .mask.show{display:flex}
  .dialog{width:600px;max-width:92vw;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:10px}
  .dialog h2{margin:0;font-size:16px}
  .grid{display:grid;grid-template-columns:120px 1fr;gap:8px 10px;align-items:center}
  .grid label{color:var(--muted);font-size:12px}
  .grid input,.grid select,.grid textarea{background:#11141a;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:7px 9px;font:inherit;width:100%}
  .grid textarea{height:60px;resize:vertical}
  .dialog .ops{display:flex;gap:8px;justify-content:flex-end}
  .dialog button{border-radius:8px;padding:8px 14px;cursor:pointer;border:1px solid var(--line);background:#232936;color:var(--text)}
  .dialog button.primary{background:#1d4ed8;border-color:#1d4ed8}
  .note{font-size:12px;color:var(--muted);min-height:18px;white-space:pre-wrap}
  /* 成员面板 / 权限准入 */
  .mp-sec{border-top:1px solid var(--line);padding-top:10px;margin-top:4px}
  .mp-sec h3{margin:0 0 6px;font-size:12px;color:var(--muted)}
  .grant{display:flex;align-items:center;gap:8px;font-size:12px;padding:3px 0}
  .grant .p{flex:1;word-break:break-all}
  .grant .m{font-size:11px;color:#f5c26b}
  .grant button,.mp-row button{font-size:11px;background:#232936;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:2px 8px;cursor:pointer}
  .grant button:hover,.mp-row button:hover{color:#fff}
  #mpModelRow{flex-wrap:wrap;gap:6px}
  #mpModelRow select,#mpModelRow input{background:#1b2230;color:var(--text);border:1px solid var(--line);
    border-radius:6px;padding:3px 6px;font-size:11.5px;max-width:260px}
  #mpModelRow input{width:150px}
  #mpModelRow .note{width:100%}
  .mp-row{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:6px}
  .mp-row input,.mp-row select{background:#11141a;color:var(--text);border:1px solid var(--line);border-radius:6px;padding:5px 8px;font:inherit;font-size:12px}
  .mp-row input{flex:1;min-width:180px}
  .perm{background:#231d13;border:1px solid #7c5a12;border-radius:10px;padding:8px 10px;font-size:12px}
  .perm .t{color:#f5c26b;font-weight:600;margin-bottom:2px}
  .perm .p{word-break:break-all;color:var(--text)}
  .perm .r{color:var(--muted);margin-top:2px}
  .perm .a{display:flex;gap:6px;margin-top:6px}
  .perm button{border-radius:6px;padding:3px 12px;font-size:11px;cursor:pointer;border:1px solid var(--line);background:#232936;color:var(--text)}
  .perm button.ok{background:#14532d;border-color:#166534;color:#bbf7d0}
  .perm button.no{background:#4c1d1d;border-color:#7f1d1d;color:#fecaca}
  .msg.perm{border-left:3px solid #f59e0b;background:#231d13}
  .msg.perm .who{color:#f5c26b}
  /* 流式输出中的气泡 */
  .msg.streaming{border-style:dashed;border-color:#3f4a5e}
  .msg.streaming .hd .chip.typing{color:#f5c26b;border-color:#7c5a12}
  /* 思维链：单独一块，可折叠 + 自己带滚动条（长思维链不截断，靠滚轮看） */
  .thtoggle{font-size:11px;background:none;border:0;color:#8fa0bd;cursor:pointer;padding:1px 6px}
  .thtoggle:hover{color:#cbd5e1}
  .thinkbox{margin:6px 0 2px;padding:6px 8px;border-left:2px solid #3b4a63;background:#141a24;
    border-radius:0 6px 6px 0;max-height:240px;overflow:auto;overscroll-behavior:contain}
  .thinkbody{white-space:pre-wrap;word-break:break-word;color:#93a1b8;font-size:12.5px;line-height:1.6}
  .thinkbox.collapsed{display:none}
  .thklbl{display:flex;gap:8px;align-items:center;color:#8fa0bd;font-size:11.5px;margin-top:4px}
  /* ---------- 执行流程步骤流（trace）----------
     2026-09-28：不再是独立的一个框，改成贴在消息体内部的一段（虚线上分界），
     名字与状态沿用消息自己的头和右上角的状态标签，不重复。 */
  .steps{margin:8px 0 0;padding-top:6px;border-top:1px dashed #2c3546;
    font-size:12.5px;line-height:1.7;
    font-family:ui-monospace,Consolas,"Courier New",monospace}
  .steps .tbody{display:flex;flex-direction:column;gap:1px}
  .tstep{display:flex;gap:8px;align-items:baseline;color:#c6d0de;white-space:pre-wrap;
    flex-wrap:wrap;word-break:break-word}
  .tstep .ico{width:1.6em;flex:none;color:#8b98ad;text-align:center}
  .tstep .lb{flex:1 1 auto;min-width:0}
  .tstep .dur{flex:none;color:#66718a;font-size:11px}
  .tstep.running{color:#f5c26b}
  .tstep.running .ico{animation:tspulse 1.1s ease-in-out infinite}
  @keyframes tspulse{0%,100%{opacity:1}50%{opacity:.35}}
  .tstep.error{color:#ef8b8b}
  .tstep.error .ico{color:#ef8b8b}
  .tstep.skipped{color:#66718a;text-decoration:line-through}
  .tstep.hasdetail{cursor:pointer}
  .tstep.hasdetail .lb::after{content:" ›";color:#66718a;opacity:.6}
  .tstep.open .lb::after{content:" ▾";opacity:1}
  .tstep .detail{display:none;width:100%;margin:3px 0 2px 1.6em;padding:6px 8px;background:#11141a;border:1px solid #2a2f3a;border-radius:6px;font-size:12px;line-height:1.55;white-space:normal}
  .tstep.open .detail{display:block}
  .tstep .detail .dpath{display:flex;gap:8px;align-items:center;margin-bottom:5px;flex-wrap:wrap}
  .tstep .detail .filelink{color:#93c5fd;text-decoration:none;border-bottom:1px solid #3b82f6;cursor:pointer;word-break:break-all}
  .tstep .detail .filelink:hover{color:#bfdbfe}
  .tstep .detail .diffstat{color:#7c879b;font-size:11px}
  .tstep .detail .diffline{display:block;white-space:pre;padding:1px 5px;margin:1px 0;border-radius:2px;font-family:ui-monospace,Consolas,monospace}
  .tstep .detail .diffadd{background:rgba(34,197,94,.14);color:#86efac}
  .tstep .detail .diffdel{background:rgba(239,68,68,.14);color:#fca5a5}
  .tstep .detail .diffctx{color:#66718a}
  .tstep .detail .cmdlbl{color:#7c879b;font-size:11px;margin-bottom:3px}
  .tstep .detail .cmdline{color:#f5c26b;white-space:pre-wrap;word-break:break-word;font-family:ui-monospace,Consolas,monospace}
  .tstep .detail .cmdout{color:#98a0b3;white-space:pre-wrap;word-break:break-word;margin-top:6px;max-height:260px;overflow:auto;font-size:11.5px}
  .tstep .detail .rawjson{color:#98a0b3;white-space:pre-wrap;word-break:break-word;font-size:11px}
  .tstep .detail .plus{color:#3fb950}
  .tstep .detail .minus{color:#f85149}
  .tstep .detail .copybtn{cursor:pointer;color:#7c879b;border:1px solid #2a2f3a;border-radius:4px;
    padding:0 5px;margin-left:6px;font-size:11px}
  .tstep .detail .copybtn:hover{color:#c6d0de;border-color:#3b82f6}
  .tstep .detail .filehead{color:#7c879b;font-size:11px;margin-top:6px}
  .tstep .detail .diffwrap{max-height:340px;overflow:auto}
  /* 拖入上传 */
  #drop{position:fixed;inset:0;z-index:40;display:none;align-items:center;justify-content:center;flex-direction:column;gap:14px;
        background:rgba(12,14,18,.72);backdrop-filter:blur(6px)}
  #drop.show{display:flex}
  .dz-icons{position:relative;width:150px;height:120px}
  .dz-icon{position:absolute;width:62px;height:62px;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#123}
  .dz-icon svg{width:32px;height:32px;stroke:#0b2b3a;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .dz-x{left:6px;top:24px;background:#8fe3d5;transform:rotate(-8deg)}
  .dz-doc{right:16px;top:4px;background:#8fb6f7;transform:rotate(8deg)}
  .dz-img{left:44px;top:52px;background:#8fb6f7;box-shadow:0 8px 24px rgba(0,0,0,.35)}
  .dz-title{font-size:20px;font-weight:600}
  .dz-sub{font-size:13px;color:#9aa4b8}
  .att-row{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 6px}
  .att-chip{font-size:11px;color:#cfe0ff;background:#1b2740;border:1px solid #2b3c5e;border-radius:999px;padding:1px 8px}
  #attBar{display:none;gap:6px;flex-wrap:wrap;align-items:center}
  #attBar.show{display:flex}
  .att-item{display:flex;align-items:center;gap:6px;font-size:11px;background:#1b2740;border:1px solid #2b3c5e;border-radius:8px;padding:3px 8px}
  .att-item button{background:none;border:0;color:#fca5a5;cursor:pointer;font-size:12px;padding:0}
  #attStatus{font-size:11px;color:var(--muted)}
</style>
</head>
<body>
<div id="shell">
  <nav id="activity" title="活动栏（图标可在 config.json 的 activity_bar 里自定义）"></nav>

  <aside id="sidebar">
    <section class="panel" data-panel="conv">
      <h2>会话</h2>
      <button id="cvNew" title="开一个新会话（可选参与成员）">＋ 开启新对话</button>
      <div id="cvList"></div>
    </section>

    <section class="panel" data-panel="agents">
      <h2>成员与模型</h2>
      <button id="addModel">＋ 添加模型</button>
      <div id="agents"></div>
      <div id="dispatchBox" class="box dsp"></div>
    </section>

    <section class="panel" data-panel="health">
      <h2>运行视图</h2>
      <div class="box">
        <div id="health"></div>
        <div class="row2">
          <button id="btnHealth">刷新健康</button>
          <button id="btnAdopt">收养孤儿消息</button>
        </div>
        <div class="note" id="healthNote"></div>
      </div>
      <div class="box">
        <h3>全局限制（0 = 无上限）</h3>
        <div class="mp-row">
          <label class="chk">历史条数 <input id="glHist" type="number" min="0" step="5" style="width:88px" /></label>
          <label class="chk">单次最大输出 <input id="glCap" type="number" min="0" step="500" style="width:96px" /></label>
          <label class="chk">单轮超时(秒) <input id="glTimeout" type="number" min="0" step="60" style="width:96px" /></label>
          <button id="glSave">保存</button>
        </div>
        <div class="note" id="glNote">历史条数 0 = 整段历史都注入（无限上下文）；单次最大输出 0 = 不截断；单轮超时 0 = 永不超时。</div>
        <div class="note" id="glModels"></div>
      </div>
    </section>

    <section class="panel" data-panel="share">
      <h2>公告板 / 共享上下文</h2>
      <textarea class="share" id="shareBox" placeholder="写分工与规则，例如：Claude 定方案，Codex 做验证，CodeBuddy 落地改文件。每轮都会注入这段内容。"></textarea>
      <div class="row2"><button id="btnShare">保存公告</button></div>
      <div class="note">保存后从下一轮起对全体生效。</div>
    </section>

    <section class="panel" data-panel="filter">
      <h2>筛选与检索</h2>
      <div class="tt" style="flex-direction:column;align-items:stretch">
        <input type="text" id="fKw" placeholder="关键字" />
        <select id="fSender"><option value="all">全部成员</option></select>
        <label class="chk"><input type="checkbox" id="kUser" checked /> 我</label>
        <label class="chk"><input type="checkbox" id="kReply" checked /> 回复</label>
        <label class="chk"><input type="checkbox" id="kError" checked /> 错误</label>
        <label class="chk"><input type="checkbox" id="kEvent" checked /> 事件</label>
        <label class="chk"><input type="checkbox" id="kMirror" checked /> 镜像</label>
        <label class="chk"><input type="checkbox" id="kHl" /> 只看高亮</label>
        <div class="row2">
          <button id="btnApply">应用筛选</button>
          <button id="btnReset">清除筛选</button>
        </div>
      </div>
    </section>
  </aside>

  <main>
    <header>
      <span class="title">群聊窗口</span>
      <span class="chip" id="mode">发送给：全体</span>
      <button id="btnReload">重新加载数据</button>
      <button id="btnReconnect">重连</button>
      <button id="clear" title="清空**本会话**的记录与执行流程，并重置各成员的会话记忆；别的会话不受影响">清空本会话上下文</button>
      <button id="shutdown" title="结束中枢进程：会中断正在跑的轮次、杀掉子进程，页面与中枢断开">关闭</button>
      <span class="conn" id="conn">连接中…</span>
    </header>
    <div class="banner" id="banner">
      <span>与中枢的连接已断开。修好后点「重连」——本窗口不会自动刷新。</span>
      <button id="btnReconnect2">重连</button>
    </div>
    <div id="log"></div>
    <footer id="composer">
      <div id="targets"></div>
      <div id="attBar"></div>
      <div class="composer">
        <textarea id="text" placeholder="输入指令…（Enter 发送 / Shift+Enter 换行；@成员名 可点名；Ctrl+V 可直接粘贴文件或截图）"></textarea>
        <button id="pick" title="选择文件（也可以直接拖到窗口里）" style="height:40px">＋ 文件</button>
        <button id="stop" disabled title="停止：中断所有正在跑的轮次，并关闭自动接力（快捷键 Esc）">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="6.5" width="11" height="11" rx="2"/></svg>
        </button>
        <button id="send">发送</button>
      </div>
      <div class="hintbar" id="hintBar" title="点击收起 / 展开这条说明">
        <span class="caret" id="hintCaret">▾</span>
        <span class="hintlabel">说明（点击展开）</span>
        <div class="hint">全部成员都在「全体」里；点某个成员 = 只跟他说话；<b>双击成员卡片 = 打开他的「工作区权限准入」</b>（授权哪些目录/文件可写，模型被写权限挡住时会发申请，你可同意或拒绝）；回复里 @名字 会自动触发对方。<b>文件/图片：拖进窗口，或直接 Ctrl+V 粘贴</b>（支持文件夹、zip、PDF、Word、Markdown、图片）。用鼠标选中文字 → 「高亮选中」，选中整条 = 整条高亮，内容以 <b>【★重要★ … ★】</b> 进模型上下文；悬停消息可「改写 / 删除 / 整条高亮」，鼠标移到高亮处会浮出「清除本条高亮」。<b>流式输出时不会抢滚动条：往上滚一下即自动暂停跟随，状态栏点「跟随」或「已暂停跟随 ↓」可恢复。</b></div>
      </div>
    </footer>
  </main>
</div>

<footer id="status"></footer>

<div id="selBar">
  <button id="selHl">高亮选中</button>
  <button id="selHlClear">清除本条高亮</button>
</div>

<div id="drop">
  <div class="dz-icons">
    <div class="dz-icon dz-x"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></div>
    <div class="dz-icon dz-doc"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg></div>
    <div class="dz-icon dz-img"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/></svg></div>
  </div>
  <div class="dz-title">文件和图片拖动到此处即可上传</div>
  <div class="dz-sub" id="dzSub">最多 50 个，每个 100 MB</div>
  <div class="dz-sub">也可以直接 Ctrl+V 粘贴文件或截图</div>
</div>

<div id="hlBar">
  <button id="hlClear">清除本条高亮</button>
</div>

<div class="mask" id="memberMask">
  <div class="dialog" style="width:660px">
    <h2 id="mpTitle">成员设置</h2>
    <div id="mpBody"></div>
    <div class="ops"><button id="mpClose">关闭</button></div>
  </div>
</div>

<div class="mask" id="sessionMask">
  <div class="dialog" style="width:560px">
    <h2>新开会话</h2>
    <div class="note" style="margin:-4px 0 8px">选本次参与的人；不勾的成员会被停用（不参与「全体」），随时可以在成员面板里再打开。</div>
    <div class="mp-sec">
      <h3>参与成员</h3>
      <div class="mp-row" id="nsMembers"></div>
      <div class="mp-row"><button id="nsAll">全选</button><button id="nsNone">全不选</button></div>
    </div>
    <div class="mp-sec">
      <h3>新会话要清掉什么</h3>
      <div class="mp-row">
        <label class="chk"><input type="checkbox" id="nsClearMsgs" /> 顺带删掉上一个会话的记录（默认保留，方便回看）</label>
      </div>
      <div class="note">新会话是独立的一份上下文，旧的会话会留在左边历史里；<b>各成员的原生记忆也是按会话各存一份</b>，所以新会话从空记忆开始，切回旧会话时那份记忆还在。公告板、系统提示词、工作区授权、成员与模型配置始终保留。</div>
    </div>
    <div class="ops"><button id="nsCancel">取消</button><button id="nsStart" class="primary">开始新会话</button>
      <span class="note" id="nsNote"></span></div>
  </div>
</div>

<div class="mask" id="mask">
  <div class="dialog">
    <h2>接入新模型</h2>
    <div class="grid">
      <label>名称</label><input id="f_label" placeholder="例如 DeepSeek / GPT-4o / GLM" />
      <label>路由方式</label>
      <select id="f_style">
        <option value="anthropic">Anthropic 兼容（/v1/messages）</option>
        <option value="openai">OpenAI 兼容（/v1/chat/completions）</option>
      </select>
      <label>Base URL</label><input id="f_base" placeholder="https://api.deepseek.com/anthropic" />
      <label>API Key</label><input id="f_key" placeholder="sk-..." />
      <label>模型名</label><input id="f_model" placeholder="deepseek-chat" />
      <label>接口路径</label><input id="f_path" placeholder="可留空自动判断" />
      <label>系统提示</label><textarea id="f_sys" placeholder="可留空，默认用群聊成员人设"></textarea>
      <label>max_tokens</label><input id="f_max" value="4096" />
    </div>
    <div class="note" id="note"></div>
    <div class="ops">
      <button id="btnTest">测试连接</button>
      <button id="btnSave" class="primary">保存并加入群聊</button>
      <button id="btnClose">关闭</button>
    </div>
  </div>
</div>

<script>
const FIXED_LABELS = { user:'我', system:'系统', claudelink:'ClaudeLink' };
// 有专属配色的 CLI 成员（对应 CSS 里的 .msg.<名字> / --<名字>）。加新成员时两边一起加。
const STYLED_AGENTS = ['claude','codex','codebuddy','dsh'];
const ICONS = {
  agents: '<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 19.5c0-3.3 2.9-5.5 6.5-5.5s6.5 2.2 6.5 5.5"/></svg>',
  pulse: '<svg viewBox="0 0 24 24"><path d="M3 12h4l2.5-6 4 12L16 12h5"/></svg>',
  bookmark: '<svg viewBox="0 0 24 24"><path d="M7 4h10v16l-5-4-5 4z"/></svg>',
  search: '<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M15.5 15.5 20 20"/></svg>',
  plug: '<svg viewBox="0 0 24 24"><path d="M12 3v6"/><path d="M9 9h6v3a3 3 0 0 1-3 3 3 3 0 0 1-3-3z"/><path d="M12 15v6"/></svg>',
  // 会话：对话气泡 + 列表线（与其它图标同一套 1.6 描边风格）
  conversations: '<svg viewBox="0 0 24 24"><path d="M20 4H4.5A1.5 1.5 0 0 0 3 5.5v9A1.5 1.5 0 0 0 4.5 16H8v4l4-4h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 20 4z"/><path d="M8 8h9M8 11.5h5"/></svg>',
  plus: '<svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>',
  chat: '<svg viewBox="0 0 24 24"><path d="M4 5h16v10H8l-4 4z"/></svg>',
  chevron: '<svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg>',
  gear: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg>'
};
const log = document.getElementById('log');
const sidebar = document.getElementById('sidebar');
const activity = document.getElementById('activity');
let agents = [];
let msgs = [];
let target = 'all';
let targets = new Set();          // 多选发送：选中的成员名；空 = 还没初始化
let openTargets = false;
let filters = { kw:'', sender:'all', onlyHl:false, kinds:{ user:true, reply:true, error:true, event:true, claudelink:true } };
let es = null;
let actItems = [];
let activePanel = localStorage.getItem('hub.panel') || 'agents';
let healthCache = null;
let pillOn = false;
let perms = [];
let HUB_CWD = '';
let memberPanelFor = null;
let dispatch = { mode: 'sequential', order: [] };
let turnsByReply = new Map();     // reply_msg_id -> {status,error_text,secs}  给回复贴状态标签
let conversations = [];           // 左侧会话列表
let activeConv = null;            // 当前会话 id

const esc = s => { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; };
const hhmmss = ts => ts ? new Date(ts*1000).toLocaleTimeString('zh-CN',{hour12:false}) : '—';
const icon = name => (name && name.trim().startsWith('<svg')) ? name : (ICONS[name] || ICONS.chat);
const labelOf = name => {
  const s = String(name ?? '');
  if(s.includes(',')){                       // 多选发送：target 存成 "a,b"
    return s.split(',').map(x=>labelOf(x.trim())).filter(Boolean).join('、');
  }
  return (agents.find(a=>a.name===s)||{}).label || FIXED_LABELS[s] || s;
};
const kindClass = m => {
  if(m.kind === 'error') return 'msg ' + m.sender + ' error';
  if(m.kind === 'claudelink') return 'msg claudelink';
  if(FIXED_LABELS[m.sender]) return 'msg ' + m.sender;
  // CLI 成员按名字上色（.msg.claude/.codex/.codebuddy/.dsh…）；加了新 CLI 成员却忘了配 CSS 时
  // 回退到 'msg model'，否则会得到一个既没边框也没名字颜色的裸气泡。
  if((agents.find(a=>a.name===m.sender) || {}).kind === 'cli')
    return 'msg ' + m.sender + (STYLED_AGENTS.includes(m.sender) ? '' : ' model');
  return 'msg model';
};
const passFilter = m => {
  if(filters.sender !== 'all' && m.sender !== filters.sender && m.target !== filters.sender) return false;
  if(filters.kw && !(m.text||'').toLowerCase().includes(filters.kw.toLowerCase())) return false;
  if(filters.onlyHl && !m.highlight) return false;
  if(m.kind === 'user' && !filters.kinds.user) return false;
  if(m.kind === 'reply' && !filters.kinds.reply) return false;
  if(m.kind === 'error' && !filters.kinds.error) return false;
  if(m.kind === 'event' && !filters.kinds.event) return false;
    if(m.kind === 'claudelink' && !filters.kinds.claudelink) return false;
  return true;
};
const filterActive = () => !!(filters.kw || filters.sender !== 'all' || filters.onlyHl ||
  Object.values(filters.kinds).some(v=>!v));

/* ---------- 活动栏 + 面板 ---------- */
function renderActivity(){
  activity.innerHTML = '';
  actItems.forEach(it=>{
    const b = document.createElement('button');
    b.className = 'act' + (it.action ? '' : (it.id === activePanel ? ' on' : ''));
    b.title = it.title || it.id;
    b.dataset.id = it.id;
    b.innerHTML = icon(it.icon);
    b.onclick = ()=>{
      if(it.action === 'dialog'){ openModelDialog(); return; }
      if(sidebar.classList.contains('hidden')){ setCollapsed(false); setPanel(it.id); return; }
      if(activePanel === it.id){ setCollapsed(true); return; }
      setPanel(it.id);
    };
    activity.appendChild(b);
  });
  const sp = document.createElement('div'); sp.className = 'spacer'; activity.appendChild(sp);
  const toggle = document.createElement('button');
  toggle.className = 'act';
  toggle.dataset.act = 'collapse';
  toggle.title = '收起 / 展开侧边栏（Ctrl+B）';
  toggle.innerHTML = ICONS.chevron;
  toggle.onclick = ()=> setCollapsed(!sidebar.classList.contains('hidden'));
  activity.appendChild(toggle);
}

function setPanel(id){
  const known = [...document.querySelectorAll('.panel')].map(p=>p.dataset.panel);
  if(!known.includes(id)) id = known[0] || 'agents';
  activePanel = id;
  localStorage.setItem('hub.panel', id);
  document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('on', p.dataset.panel === id));
  renderActivity();
}

function setCollapsed(hidden){
  sidebar.classList.toggle('hidden', hidden);
  activity.classList.toggle('collapsed', hidden);
  localStorage.setItem('hub.collapsed', hidden ? '1' : '0');
}

/* ---------- 底部状态栏 ---------- */
function renderStatus(){
  const st = document.getElementById('status');
  const h = healthCache || {};
  const running = (h.running || []).length;
  const stopBtn = document.getElementById('stop');
  if(stopBtn){
    const busy = running > 0 || agents.some(a=>a.running_since);
    stopBtn.disabled = !busy;
    stopBtn.classList.toggle('live', busy);
    stopBtn.title = busy
      ? `停止：中断正在跑的 ${agents.filter(a=>a.running_since).map(a=>a.label).join('、') || running + ' 个轮次'}，并关闭自动接力（Esc）`
      : '停止：当前没有在跑的轮次（Esc）';
  }
  const connected = es && es.readyState === 1;
  const follow = document.getElementById('followState').checked;
  const relay = document.getElementById('relayState').checked;
  const parts = [
    `<span class="st ${connected?'dot-green':'dot-red'}" data-go="reconnect" title="点击重连">${connected?'已连接':'已断开'}</span>`,
    `<span class="st" data-go="info" title="中枢地址">${location.host}</span>`,
    `<span class="st" data-go="agents" title="启用 / 全部成员">成员 ${h.agents_enabled ?? '-'}/${h.agents_total ?? '-'}</span>`,
    `<span class="st ${running?'dot-amber':''}" data-go="health" title="正在处理">处理中 ${running}</span>`,
    `<span class="st" data-go="filter" title="已加载消息数 / 失败轮次">消息 ${msgs.length} · 失败 ${h.errors ?? 0}</span>`,
    `<span class="st" data-go="share" title="上下文来源">记忆 窗口 ${h.history_limit ?? ''}${(agents.find(a=>a.native_memory)||{}).label ? ' · 原生:' + agents.filter(a=>a.native_memory).map(a=>a.label).join(',') : ''}</span>`,
    `<span class="st" data-go="filter" title="筛选状态">筛选 ${filterActive()?'开':'关'}</span>`,
    '<span class="spacer"></span>',
    `<span class="st" data-go="bottom" title="跳到底部并恢复跟随" id="newPill"${pillOn?'':' style="display:none"'}>${
      followPaused ? '已暂停跟随 · 有新消息 ↓' : '有新消息 ↓'}</span>`,
    `<span class="st ${follow ? (followPaused ? '' : '') : 'off'}" data-go="follow"
      title="点击切换跟随；往上滚会自动暂停">跟随 ${
        follow ? (followPaused ? '开(已暂停)' : '开') : '关'}</span>`,
    `<span class="st ${relay?'':'off'}" data-go="relay" title="点击切换自动接力">接力 ${relay?'开':'关'}</span>`,
    `<span class="st" data-go="agents" title="发给「全体」时的执行次序（成员与模型面板里可调）">次序 ${dispatch.mode === 'parallel' ? '同时' : '依次'}</span>`,
    `<span class="st" data-go="target" title="当前发送对象（可多选）">目标 ${target==='all'?'全体':esc(labelOf(target))}</span>`,
  ];
  const html = parts.join('');
  if(html === lastStatusHtml) return;      // 内容没变就别重画：多成员同时流式时这是抖动的最大来源
  lastStatusHtml = html;
  st.innerHTML = html;
  st.querySelectorAll('.st').forEach(el=>{
    el.onclick = ()=> statusClick(el.getAttribute('data-go'));
  });
}
let lastStatusHtml = '';
let statusSoonTimer = null;
function renderStatusSoon(){               // 状态事件很密：合并到 300ms 一次
  if(statusSoonTimer) return;
  statusSoonTimer = setTimeout(()=>{ statusSoonTimer = null; renderStatus(); }, 300);
}

function statusClick(go){
  if(go === 'reconnect'){ connect(); return; }
  if(go === 'agents' || go === 'health' || go === 'share' || go === 'filter'){ setCollapsed(false); setPanel(go); return; }
  if(go === 'bottom'){ jumpBottom(); return; }
  if(go === 'target'){ document.getElementById('targets').scrollIntoView({block:'nearest'}); return; }
  if(go === 'follow'){
    const c = document.getElementById('followState');
    if(c.checked && followPaused){
      followPaused = false;                 // 已开但暂停 → 先恢复跟随
    } else {
      c.checked = !c.checked;
      followPaused = false;
    }
    localStorage.setItem('hub.follow', c.checked ? '1' : '0');
    renderStatus();
    return;
  }
  if(go === 'relay'){ const c = document.getElementById('relayState'); c.checked = !c.checked; c.onchange({target:c}); renderStatus(); return; }
}

/* ---------- 消息渲染 ---------- */
function nodeFor(m){
  if(m.kind === 'perm'){
    const d = document.createElement('div');
    d.className = 'msg perm';
    d.dataset.id = m.id;
    const rid = (m.ref || '').split(':')[1] || '';
    d.innerHTML = `<div class="hd"><span class="who">权限申请</span><span>${hhmmss(m.ts)}</span></div>`
      + `<div class="perm"><div class="t">${esc(labelOf(m.sender))} 需要权限</div>`
      + `<div class="p">${esc(m.text)}</div>`
      + `<div class="a"><button class="ok" data-perm-ok="${rid}">同意</button>`
      + `<button class="no" data-perm-no="${rid}">拒绝</button></div></div>`;
    return d;
  }
  if(m.kind === 'event'){
    const d = document.createElement('div');
    d.className = 'sys';
    d.dataset.id = m.id;
    d.innerHTML = esc(m.text)
                + (m.highlight ? '' : ' <button data-hl="'+m.id+'">整条高亮</button>')
                + ' <button class="delmsg" data-del="'+m.id+'">删除</button>';
    if(m.highlight) d.classList.add('hl');
    return d;
  }
  const div = document.createElement('div');
  const segs = m.highlights || [];
  div.className = kindClass(m) + (m.highlight ? (segs.length ? ' hlfrag' : ' hl') : '');
  div.dataset.id = m.id;
  const tgt = m.target && m.target !== 'all' ? `<span class="chip">→ ${esc(labelOf(m.target))}</span>` : '';
  const acts = [];
  if(m.can_retry) acts.push('<button class="retry" data-retry="'+m.id+'">重试这条</button>');
  if(m.kind === 'user' || m.kind === 'reply') acts.push('<button data-edit="'+m.id+'">改写</button>');
  acts.push(m.highlight
    ? ''
    : '<button data-hl="'+m.id+'">整条高亮</button>');
  acts.push('<button class="danger" data-del="'+m.id+'">删除</button>');
  const star = m.highlight ? `<span class="star">★ 重要${segs.length>1?'×'+segs.length:''}</span>` : '';
    const st = m.kind === 'reply' ? turnsByReply.get(m.id) : null;
    const statChip = st ? statusChip(st) : '';
  const atts = (m.attachments || []).map(a=>`<span class="att-chip" title="${esc(a.kind)}">📎 ${esc(a.name)}</span>`).join(' ');
  const shown = m.display_text != null ? m.display_text : m.text;
    div.innerHTML = `<div class="hd"><span class="who">${esc(labelOf(m.sender))}</span>${tgt}${star}${statChip}<span>${hhmmss(m.ts)}</span>${acts.join('')}</div>`
    + (atts ? `<div class="att-row">${atts}</div>` : '')
      + (st && st.error_text ? `<div class="errline">错误：${esc(st.error_text)}</div>` : '')
    + `<div class="body">${m.display_text != null ? esc(shown) : bodyHtml(m)}</div>`;
  return div;
}

  /* 每轮的结果标签：成功 / 失败 / 超时 / 中断（失败时下面还有一行错误原文） */
  function statusChip(st){
    const secs = st.secs != null ? ` ${st.secs}s` : '';
    if(st.status === 'ok')          return `<span class="chip tstat ok" title="本轮执行成功">完成${secs}</span>`;
    if(st.status === 'error')       return `<span class="chip tstat err" title="${esc(st.error_text || '')}">失败${secs}</span>`;
    if(st.status === 'timeout')     return `<span class="chip tstat warn" title="超过单轮超时">超时${secs}</span>`;
    if(st.status === 'interrupted') return `<span class="chip tstat warn" title="被停止键中断">已中断${secs}</span>`;
    return `<span class="chip tstat">${esc(st.status || '')}${secs}</span>`;
  }

  function turnRow(t){
    return {
      status: t.status,
      error_text: t.error_text || '',
      secs: t.end_ts && t.start_ts ? Math.round((t.end_ts - t.start_ts) / 100) / 10 : null,
    };
  }
  function indexTurns(list){
    turnsByReply = new Map();
    (list || []).forEach(t=>{ if(t && t.reply_msg_id) turnsByReply.set(t.reply_msg_id, turnRow(t)); });
  }

function bodyHtml(m){
  const text = m.text || '';
  const segs = (m.highlights || []).slice().sort((a,b)=>a.start-b.start);
  if(!segs.length) return esc(text);
  let out = '', pos = 0;
  segs.forEach(s0=>{
    const s = Math.max(0, Math.min(text.length, s0.start));
    const e = Math.max(s, Math.min(text.length, s0.end));
    if(s < pos) return;
    out += esc(text.slice(pos, s));
    out += '<span class="hlseg">' + esc(text.slice(s, e)) + '</span>';
    pos = e;
  });
  out += esc(text.slice(pos));
  return out;
}

function applyMessageHighlight(m){
  const i = msgs.findIndex(x=>x.id === m.id);
  if(i >= 0) msgs[i] = m;
  const node = log.querySelector(`[data-id="${m.id}"]`);
  if(!node) return;
  node.replaceWith(nodeFor(m));   // 只替换这一条，不动其它节点与滚动位置
}

function startEdit(node, m){
  const box = node.querySelector('.body');
  if(!box) return;
  box.innerHTML = '';
  const ta = document.createElement('textarea');
  ta.className = 'edit';
  ta.value = m.text;
  const bar = document.createElement('div');
  bar.className = 'editbar';
  const ok = document.createElement('button'); ok.className = 'primary'; ok.textContent = '保存';
  const cancel = document.createElement('button'); cancel.textContent = '取消';
  ok.onclick = async ()=>{
    const text = ta.value.trim();
    if(!text){ alert('内容不能为空'); return; }
    const r = await post('/api/messages/edit', {id:m.id, text});
    if(!r.ok){ alert('改写失败：' + r.error); return; }
    m.text = text; applyMessageUpdate(r.message);
  };
  cancel.onclick = ()=>{ box.textContent = m.text; };
  bar.appendChild(ok); bar.appendChild(cancel);
  box.appendChild(ta); box.appendChild(bar);
  ta.focus();
}

function applyMessageUpdate(m){
  const i = msgs.findIndex(x=>x.id === m.id);
  if(i >= 0) msgs[i] = m;
  const node = log.querySelector(`[data-id="${m.id}"]`);
  if(!node) return;
  const body = node.querySelector('.body');
  if(body) body.textContent = m.text; else node.textContent = m.text;
}

function applyMessageDelete(id){
  msgs = msgs.filter(x=>x.id !== id);
  const node = log.querySelector(`[data-id="${id}"]`);
  if(node) node.remove();
}

function atBottom(){ return log.scrollHeight - log.scrollTop - log.clientHeight < 40; }

/* ---------- 跟随滚动：用户一动滚轮就暂停，绝不抢滚动条 ---------- */
let followPaused = false;     // 用户往上滚过 → 暂停自动跟随
let autoScrolling = false;    // 标记程序自己的那次滚动，避免误判成用户操作

function scrollLogToBottom(){
  autoScrolling = true;
  // 多个成员一起流式时，每次增量都滚一次会让滚动条抖；按帧合并成一次
  if(scrollPending) return;
  scrollPending = true;
  requestAnimationFrame(()=>{
    scrollPending = false;
    log.scrollTop = log.scrollHeight;
  });
}
let scrollPending = false;

function followWanted(){
  return document.getElementById('followState').checked && !followPaused;
}

log.addEventListener('wheel', e=>{
  if(e.deltaY < 0 && !atBottom()){
    followPaused = true;      // 只要往上滚，立刻交还滚动控制权
    pillOn = true;
    renderStatus();
  }
});

log.addEventListener('touchmove', ()=>{
  if(!atBottom()){
    followPaused = true;
    pillOn = true;
    renderStatus();
  }
}, {passive:true});
function jumpBottom(){
  followPaused = false;
  scrollLogToBottom();
  pillOn = false;
  const pill = document.getElementById('newPill');
  if(pill) pill.style.display = 'none';
  renderStatus();
}

function handleMessage(m){
  msgs.push(m);
  if(m.kind === 'reply' || m.kind === 'error' || m.kind === 'perm') clearStream(m.sender);
  if(m.sender && m.kind === 'reply'){
    const a = agents.find(x=>x.name===m.sender);
    if(a){ a.sent = (a.sent||0)+1; a.last_active = m.ts; patchMeta(a); }
  }
  if(passFilter(m)){
    log.appendChild(nodeFor(m));
    if(followWanted()) scrollLogToBottom();
    else { pillOn = true; }
  } else {
    pillOn = true;
  }
  renderStatus();
}

let renderLimit = 200;      // 一次最多渲染多少条：长会话（默认上限 1000 条）不至于把 DOM 撑爆

function renderTimeline(){
  log.innerHTML = '';
  const filtered = msgs.filter(passFilter);
  const hidden = Math.max(0, filtered.length - renderLimit);
  if(hidden > 0){
    const wrap = document.createElement('div');
    wrap.className = 'sys';
    const btn = document.createElement('button');
    btn.className = 'morebtn';
    btn.textContent = `加载更早的 ${Math.min(hidden, renderLimit)} 条（更早还有 ${hidden} 条）`;
    btn.onclick = ()=>{ renderLimit += 200; renderTimeline(); };
    wrap.appendChild(btn);
    log.appendChild(wrap);
  }
  filtered.slice(-renderLimit).forEach(m=>log.appendChild(nodeFor(m)));
  // 步骤流节点被 innerHTML='' 清掉了，按 reply 挂回对应消息下面
  turnNodes.forEach(n=>{
    const target = n.dataset.reply && log.querySelector(`[data-id="${n.dataset.reply}"]`);
    if(target) target.appendChild(n);        // 步骤贴在消息内部，不再单独成块
    else log.appendChild(n);
  });
  pillOn = false;
}

/* ---------- 流式输出 ---------- */
/* 思维链默认展开还是收起（用户自己点一次就记住） */
function thinkCollapsed(){ return localStorage.getItem('hub.think') === '0'; }

function updateStream(agent, state, live, think){
  let node = log.querySelector(`[data-stream="${agent}"]`);
  if(state === 'running' && (live || think)){
    if(!node){
      node = document.createElement('div');
      node.dataset.stream = agent;
      node.className = kindClass({sender: agent, kind: 'reply'}) + ' streaming';
        node.innerHTML = `<div class="hd"><span class="who">${esc(labelOf(agent))}</span>`
          + `<span class="chip typing">输出中…</span>`
          + `<button class="thtoggle" data-th="${esc(agent)}">思维链 <span class="thchars"></span> ▾</button>`
          + `</div>`
          + `<div class="thinkbox${thinkCollapsed() ? ' collapsed' : ''}"><div class="thinkbody"></div></div>`
          + `<div class="body"></div>`;
        log.appendChild(node);
        // 这一轮若已经建过步骤容器（turn_started 早于第一段输出），把它搬进气泡
        const steps = turnNodes.get(liveTurnByAgent.get(agent));
        if(steps) node.appendChild(steps);
      }
    const box = node.querySelector('.thinkbox');
    const tbody = node.querySelector('.thinkbody');
    if(box && tbody){
      const txt = think || '';
      box.style.display = txt ? '' : 'none';
      if(tbody.textContent !== txt){
        tbody.textContent = txt;
        // 用户自己往上滚过就不再自动跟底（和主日志同一套规矩）
        if(!tbody.dataset.userScrolled) tbody.scrollTop = tbody.scrollHeight;
      }
      const chip = node.querySelector('.thchars');
      if(chip) chip.textContent = txt ? `（${txt.length} 字）` : '';
    }
    const body = node.querySelector('.body');
    if(body && body.textContent !== (live || '')) body.textContent = live || '';
    if(followWanted()) scrollLogToBottom();
    else if(!followPaused) pillOn = true;
  } else if(node){
    node.remove();
  }
}

function clearStream(agent){
  const node = log.querySelector(`[data-stream="${agent}"]`);
  if(node) node.remove();
}

/* ---------- 成员卡片 ---------- */
function patchMeta(a){
  const el = document.querySelector(`.agent[data-name="${a.name}"] .meta`);
  if(!el) return;
  // 没有原生会话能力的成员（dsh）永远不会有 session，别一直显示"未开始"误导人
  const run = a.running_since ? `运行中（开始于 ${hhmmss(a.running_since)}）`
    : (a.native_memory_capable === false ? '无原生会话'
      : (a.session ? String(a.session).slice(0,24) : '未开始'));
  const mem = a.native_memory_capable === false ? '仅窗口记忆'
    : (a.native_memory ? '原生记忆' : '窗口记忆');
  el.textContent = `${run} · 发 ${a.sent||0} / 收 ${a.received||0} · 最近 ${hhmmss(a.last_active)} · ${mem}`;
}

function patchDot(a, state){
  const el = document.querySelector(`.agent[data-name="${a.name}"] .dot`);
  if(el) el.className = 'dot ' + (state === 'running' ? 'run' : (a.enabled ? 'on' : 'off'));
  const btn = document.querySelector(`.agent[data-name="${a.name}"] button[data-act="interrupt"]`);
  if(btn) btn.style.display = state === 'running' ? '' : 'none';
}

