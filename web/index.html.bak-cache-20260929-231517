  }

  /* 执行顺序：发给「全体」时谁先谁后（同时触发时谁也看不到别人刚说的话） */
  function dispatchNames(){
    const list = (dispatch.order || []).filter(n=>agents.some(a=>a.name===n));
    agents.forEach(a=>{ if(!list.includes(a.name)) list.push(a.name); });
    return list;
  }
  function renderDispatch(){
    const box = document.getElementById('dispatchBox');
    if(!box) return;
    const mode = dispatch.mode === 'parallel' ? 'parallel' : 'sequential';
    const names = dispatchNames();
    const mode3 = ['sequential','parallel','auto'].includes(dispatch.mode) ? dispatch.mode : 'sequential';
    box.innerHTML = `<h3>执行顺序（发给「全体」时）</h3>`
      + `<select id="dspMode">`
      + `<option value="sequential"${mode3 === 'sequential' ? ' selected' : ''}>依次执行：按下面次序，一个说完下一个才开始</option>`
      + `<option value="parallel"${mode3 === 'parallel' ? ' selected' : ''}>同时执行：所有人一起跑</option>`
      + `<option value="auto"${mode3 === 'auto' ? ' selected' : ''}>让成员自己排：先只问调度者，由它指定谁先谁后/谁同时</option>`
      + `</select>`
      + `<div class="dsp-note">${mode3 === 'sequential'
          ? '按下面次序一个个跑：上一位的回复已经落库，下一位开跑时就能读到它。'
