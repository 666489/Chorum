async function renderModelBlock(name, a){
    const row = document.getElementById('mpModelRow');
    if(!row) return;
    if(a.kind !== 'cli'){                  // 自定义模型不查 CLI 清单，直接渲染编辑表单
      renderCustomModelForm(row, name, a);
      return;
    }
    if(a.model_capable === false){
      // 该 CLI 不接收模型参数（dsh headless 只有 -h/--help）。给一个选了也没用的下拉框等于骗人，
      // 所以这里直接说明模型在哪儿配。上面的说明文字已同步（见 mpModelRow 那段 note）。
      row.innerHTML = `<span class="note">该 CLI 的模型由它自己的配置决定，这里无法覆盖。</span>`;
      return;
    }
    let data = null;
    try{ data = await (await fetch('/api/model-choices?agent=' + encodeURIComponent(name))).json(); }catch(e){}
  if(!data || !data.ok){
    row.innerHTML = `<span class="note">读取可选模型失败：${esc((data && data.error) || '连接失败')}</span>`;
    return;
  }
    const cur = data.current || {};
    const all = data.choices || [];
  const models = all.filter(c=>c.kind !== 'profile');
  const profiles = all.filter(c=>c.kind === 'profile');
  const opt = c => `<option value="${esc(c.value)}" title="${esc(c.note || '')}">${esc(c.label)}${c.note ? ' · ' + esc(c.note) : ''}</option>`;
  row.innerHTML =
    (name === 'claude'
      ? `<label class="chk">配置 profile <select id="mpProfile"><option value="">（不指定）</option>${profiles.map(opt).join('')}</select></label>`
      : '')
    + `<label class="chk">模型 <select id="mpModelSel"><option value="">（跟随 CLI 自身配置）</option>${models.map(opt).join('')}</select></label>`
    + `<input id="mpModelFree" placeholder="或手填模型 ID" value="${esc(cur.model || '')}" />`
    + (name === 'codex' ? `<input id="mpProvider" placeholder="provider（一般留空）" value="${esc(cur.model_provider || '')}" />` : '')
    + `<button id="mpModelApply">应用</button>`
    + `<div class="note" id="mpModelNote"></div>`;
  const sel = row.querySelector('#mpModelSel');
  const free = row.querySelector('#mpModelFree');
  const prof = row.querySelector('#mpProfile');
  if(sel && cur.model) sel.value = cur.model;              // 若在清单里就回显
  if(prof && cur.settings_profile) prof.value = cur.settings_profile;
  if(sel) sel.onchange = ()=>{ if(sel.value) free.value = sel.value; };
  row.querySelector('#mpModelApply').onclick = async ()=>{
    const note = row.querySelector('#mpModelNote');
    const body = { agent: name, model: (free.value || '').trim() || (sel ? sel.value : '') };
    if(prof) body.settings_profile = prof.value;
    const pv = row.querySelector('#mpProvider');
    if(pv) body.model_provider = pv.value.trim();
    const r = await post('/api/agents/model', body);
    if(!r.ok){ note.textContent = '保存失败：' + r.error; return; }
    note.textContent = '已保存，下一轮生效';
  };
}

