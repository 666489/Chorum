/* 鼠标选中文字 → 浮动「高亮选中」 */
const selBar = document.getElementById('selBar');
let pendingSel = null;
const hideSelBar = ()=>{ selBar.style.display = 'none'; };
document.addEventListener('mouseup', ev=>{
  if(ev.target && ev.target.closest && ev.target.closest('#selBar')) return;
  const sel = window.getSelection();
  if(!sel || sel.isCollapsed || !sel.toString().trim()){ hideSelBar(); return; }
  const range = sel.getRangeAt(0);
  let node = range.commonAncestorContainer;
  if(node.nodeType !== 1) node = node.parentElement;
  const body = node && node.closest ? node.closest('.body') : null;
  const bubble = body && body.closest ? body.closest('.msg') : null;
  if(!body || !bubble){ hideSelBar(); return; }
  const id = parseInt(bubble.dataset.id, 10);
  const m = msgs.find(x=>x.id === id);
  if(!m){ hideSelBar(); return; }
  const pre = document.createRange();
  pre.selectNodeContents(body);
  pre.setEnd(range.startContainer, range.startOffset);
  const start = pre.toString().length;
  const end = start + sel.toString().length;
  if(end <= start){ hideSelBar(); return; }
  pendingSel = { id, start, end };
  document.getElementById('selHlClear').style.display = m.highlight ? '' : 'none';
  hideHlBar();                                    // 选区浮条出现时，收起高亮浮条，避免叠在一起
  const rect = range.getBoundingClientRect();
  selBar.style.display = 'flex';
  selBar.style.left = Math.max(6, Math.min(window.innerWidth - 230, rect.left + rect.width / 2 - 90)) + 'px';
  selBar.style.top = Math.max(6, rect.top - 38) + 'px';
});
document.addEventListener('mousedown', e=>{
  if(!(e.target && e.target.closest && e.target.closest('#selBar'))) hideSelBar();
});
