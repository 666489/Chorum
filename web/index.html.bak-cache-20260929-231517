          ? '同时执行时大家拿到同一份上下文，谁都看不到本轮别人说了什么。'
          : '先只跑调度者，它会输出一行 [[ORDER 名字>名字|名字]]（<code>&gt;</code>=先后，<code>|</code> 或 <code>,</code>=同时），系统照此执行；没给指令就退回面板次序。'}</div>`
      + (mode3 === 'auto'
          ? `<div class="dsp-planner">调度者 <select id="dspPlanner">`
            + `<option value=""${dispatch.planner ? '' : ' selected'}>（次序第一：${esc(labelOf(names[0] || ''))}）</option>`
            + names.map(n=>`<option value="${esc(n)}"${dispatch.planner === n ? ' selected' : ''}>${esc(labelOf(n))}</option>`).join('')
            + `</select></div>`
          : '')
      + names.map((n, i)=>`<div class="dsp-item" data-name="${esc(n)}">`
          + `<span class="ord">${i + 1}</span>`
          + `<span class="who">${esc(labelOf(n))}</span>`
          + `<button class="up"${i === 0 ? ' disabled' : ''} title="上移">↑</button>`
          + `<button class="down"${i === names.length - 1 ? ' disabled' : ''} title="下移">↓</button>`
          + `</div>`).join('');
    const sel = box.querySelector('#dspMode');
    sel.onchange = ()=> saveDispatch({ mode: sel.value });
    const pl = box.querySelector('#dspPlanner');
    if(pl) pl.onchange = ()=> saveDispatch({ planner: pl.value });
    box.querySelectorAll('.dsp-item').forEach(row=>{
      const name = row.getAttribute('data-name');
      const move = async dir=>{
        const list = dispatchNames();
        const i = list.indexOf(name), j = i + dir;
        if(i < 0 || j < 0 || j >= list.length) return;
        [list[i], list[j]] = [list[j], list[i]];
        await saveDispatch({ order: list });
      };
      const up = row.querySelector('.up'), dn = row.querySelector('.down');
      if(up) up.onclick = ()=> move(-1);
      if(dn) dn.onclick = ()=> move(1);
    });
  }
  async function saveDispatch(patch){
    const r = await post('/api/dispatch', patch);
    if(!r.ok){ alert('保存失败：' + r.error); return; }
    dispatch = r.dispatch || dispatch;
    renderDispatch(); renderStatus();
  }

  function renderTargets(){
  const box = document.getElementById('targets');
  box.innerHTML = '';
    const enabled = agents.filter(a=>a.enabled);
    const known = new Set(agents.map(a=>a.name));
    [...targets].forEach(n=>{ if(!known.has(n)) targets.delete(n); });
    if(!targets.size) enabled.forEach(a=>targets.add(a.name));      // 首次进来 = 全体
    const allOn = enabled.length > 0 && enabled.every(a=>targets.has(a.name));
    const syncTarget = ()=>{ target = allOn ? 'all' : [...targets].join(','); };
    syncTarget();
    const head = document.createElement('button');
    head.textContent = '全体';
    head.className = allOn ? 'on' : '';
    head.title = '全选（再点一次保持全选）';
    head.onclick = ()=>{ targets = new Set(enabled.map(a=>a.name)); renderTargets(); renderAgents(); renderStatus(); };
    box.appendChild(head);
    agents.forEach(a=>{
      const b = document.createElement('button');
      b.textContent = a.label;
      b.className = targets.has(a.name) ? 'on' : '';
      if(!a.enabled) b.title = '该成员已停用（不参与全体），仍可单独指定';
      b.onclick = ()=>{
        if(targets.has(a.name)){
          if(targets.size === 1) return;                            // 至少留一个收件人
          targets.delete(a.name);
        } else {
          targets.add(a.name);
        }
        renderTargets(); renderAgents(); renderStatus();
      };
      box.appendChild(b);
    });
    const tip = document.createElement('span');
    tip.className = 'chip';
    tip.id = 'targetTip';
    tip.textContent = allOn ? '发给全体' : `发给 ${[...targets].map(n=>labelOf(n)).join('、')}`;
    box.appendChild(tip);
  const sel = document.getElementById('fSender');
  const cur = sel.value;
  sel.innerHTML = '<option value="all">全部成员</option>' + agents.map(a=>`<option value="${esc(a.name)}">${esc(a.label)}</option>`).join('');
  sel.value = [].some.call(sel.options, o=>o.value===cur) ? cur : 'all';
}

/* ---------- 健康 ---------- */
function renderHealth(h, nexus){
  const rows = [
    ['成员（启用/全部）', `${h.agents_enabled} / ${h.agents_total}`],
    ['消息总数', h.messages],
    ['失败轮次', h.errors],
    ['正在处理', (h.running||[]).map(r=>`${r.label}（${hhmmss(r.started)} 起）`).join('、') || '无'],
    ['hub.db', (h.db_bytes/1024).toFixed(0) + ' KB'],
    ['镜像最近读取', hhmmss(h.nexus_last_scan)],
    ['nexus 未读孤儿', nexus ? nexus.orphans : '—'],
    ['历史窗口', (h.history_limit ?? '—') + ' 条'],
    ['最近错误', h.last_error || '无'],
  ];
  document.getElementById('health').innerHTML = rows.map(([k,v])=>
    `<div class="kv"><span>${esc(k)}</span><b>${esc(String(v))}</b></div>`).join('');
}

async function post(path, body){
  try{
    return await (await fetch(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})})).json();
  }catch(e){ return {ok:false, error:'连接失败'}; }
}

async function loadAgents(){
  const s = await (await fetch('/api/state')).json();
  agents = s.agents;
  perms = s.perms || [];
  if(s.dispatch) dispatch = s.dispatch;
  if(s.conversations){ conversations = s.conversations; activeConv = s.conversation; }
  indexTurns(s.turns);
  document.getElementById('relayState').checked = s.relay;
  renderTargets(); renderAgents(); renderDispatch(); renderConversations(); renderStatus();
  if(memberPanelFor) openMemberPanel(memberPanelFor);
  return s;
}

async function loadPerms(){
  try{ perms = (await (await fetch('/api/perms')).json()).perms || []; }
  catch(e){ perms = []; }
  if(memberPanelFor) openMemberPanel(memberPanelFor);
}

