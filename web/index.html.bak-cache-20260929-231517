  if(t.closest('#hlBar')) return;                 // 指针在浮条上，保持显示
  const inside = t.closest('.msg, .sys');
  const insideId = inside ? parseInt(inside.dataset.id, 10) : null;
  if(hlShownFor !== null && insideId === hlShownFor) return;  // 还在同一条里：位置不动
  const seg = t.closest('.hlseg');
