/* 「清除本条高亮」：鼠标移到高亮处时，在光标位置浮现并停住，方便直接点它 */
const hlBar = document.getElementById('hlBar');
let hlTargetId = null;
let hlShownFor = null;   // 当前浮条属于哪一条消息
function hideHlBar(){ hlBar.style.display = 'none'; hlTargetId = null; hlShownFor = null; }
function showHlBar(x, y){
  hlBar.style.display = 'flex';
  hlBar.style.left = Math.min(window.innerWidth - 150, x + 6) + 'px';
  hlBar.style.top = Math.min(window.innerHeight - 36, y + 10) + 'px';
