      `<label class="chk">模型 ID <input id="mpModelFree" placeholder="例如 deepseek-flash" value="${esc(a.session || '')}" /></label>`
    + `<label class="chk">Base URL <input id="mpBaseUrl" value="${esc(a.base_url || '')}" /></label>`
