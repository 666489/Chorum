log.addEventListener('click', async e=>{
  const el = e.target;
  if(!el || !el.getAttribute) return;
  // --- 步骤详情（§27）：先处理，别落到下面的消息按钮分支 ---
  const copyText = el.getAttribute('data-copy');
  if(copyText !== null){
    try{
      await navigator.clipboard.writeText(copyText);
      el.textContent = '已复制';
      setTimeout(()=>{ el.textContent = '复制'; }, 1200);
    }catch(err){ alert(copyText); }          // 剪贴板被拒时至少让用户能手工复制
    return;
  }
  const filePath = el.getAttribute('data-file');
  if(filePath){
    const row = el.closest('[data-step]');
    const id = row ? parseInt(row.dataset.step, 10) : NaN;
    if(!isNaN(id)) await showFile(id, filePath, 0);
    return;
  }
  // 点行本身切换展开；点面板内部不切换（否则看 diff 时会被自己点回去）
  const stepRow = el.closest('.tstep.hasdetail');
  if(stepRow && !el.closest('.detail')){
    const id = parseInt(stepRow.dataset.step, 10);
    if(!isNaN(id)){
      if(openSteps.has(id)) openSteps.delete(id); else openSteps.add(id);
      repaintStep(id);
    }
    return;
  }
  const retryId = el.getAttribute('data-retry');
  if(retryId){
    const r = await post('/api/retry', {message_id: parseInt(retryId,10)});
    if(!r.ok) alert('重试失败：' + r.error);
    return;
  }
  // 思维链折叠 / 展开（流式气泡里那块；偏好记在 localStorage）
  const thAgent = el.getAttribute('data-th');
  if(thAgent !== null){
    const bubble = el.closest('.msg, .sys');
    const box = bubble && bubble.querySelector('.thinkbox');
    if(box){
      const chars = el.querySelector('.thchars');
      const charsTxt = chars ? chars.textContent : '';
      box.classList.toggle('collapsed');
      localStorage.setItem('hub.think', box.classList.contains('collapsed') ? '0' : '1');
      el.innerHTML = '思维链 <span class="thchars">' + charsTxt + '</span> '
        + (box.classList.contains('collapsed') ? '▸' : '▾');
      const tb = box.querySelector('.thinkbody');
      if(tb && !box.classList.contains('collapsed') && !tb.dataset.userScrolled) tb.scrollTop = tb.scrollHeight;
    }
    return;
  }
  const editId = el.getAttribute('data-edit');
  if(editId){
    const m = msgs.find(x=>x.id === parseInt(editId,10));
    const node = log.querySelector(`[data-id="${editId}"]`);
    if(m && node) startEdit(node, m);
    return;
  }
  const hlId = el.getAttribute('data-hl');
  if(hlId){
    const r = await post('/api/messages/highlight', {id: parseInt(hlId,10), on: true});
    if(!r.ok){ alert('操作失败：' + r.error); return; }
    applyMessageHighlight(r.message);
    return;
  }
  const delId = el.getAttribute('data-del');
  if(delId){
    if(!confirm('删除这条消息？删除后模型下一轮起看不到它。')) return;
    const r = await post('/api/messages/delete', {id: parseInt(delId,10)});
    if(!r.ok){ alert('删除失败：' + r.error); return; }
    applyMessageDelete(parseInt(delId,10));
    return;
  }
  const okId = el.getAttribute('data-perm-ok');
  const noId = el.getAttribute('data-perm-no');
  if(okId || noId){
    const rid = parseInt(okId || noId, 10);
    const r = await post('/api/perms/resolve', {id: rid, approve: !!okId});
    if(!r.ok){ alert('操作失败：' + r.error); return; }
    // 申请卡当场消失（服务端也删了那条消息并广播，这里先落地，不等往返）
    const card = msgs.find(m=> m.kind === 'perm' && (m.ref || '') === 'perm:' + rid);
    if(card) applyMessageDelete(card.id);
    await loadAgents();
  }
});
