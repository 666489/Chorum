const form = ()=>({
  label: document.getElementById('f_label').value.trim(),
  style: document.getElementById('f_style').value,
  base_url: document.getElementById('f_base').value.trim(),
  api_key: document.getElementById('f_key').value.trim(),
  model: document.getElementById('f_model').value.trim(),
  path: document.getElementById('f_path').value.trim(),
  system_prompt: document.getElementById('f_sys').value.trim(),
  max_tokens: parseInt(document.getElementById('f_max').value || '4096', 10),
});
document.getElementById('btnTest').onclick = async ()=>{
  note.textContent = '测试中…';
  const j = await post('/api/models/test', form());
  note.textContent = j.ok ? '连接成功，模型回复：' + j.reply : '失败：' + j.error;
};
document.getElementById('btnSave').onclick = async ()=>{
  const j = await post('/api/models', form());
  if(!j.ok){ note.textContent = '保存失败：' + j.error; return; }
  note.textContent = '已加入群聊：' + j.model.label;
  mask.classList.remove('show');
  document.getElementById('f_key').value = '';
  await loadAgents();
};

/* ---------- 启动 ---------- */
(async function init(){
  actItems = [
    {id:'agents', title:'成员与模型', icon:'agents'},
    {id:'health', title:'运行视图', icon:'pulse'},
    {id:'share', title:'公告板', icon:'bookmark'},
    {id:'filter', title:'筛选与检索', icon:'search'},
    {id:'add-model', title:'添加模型', icon:'plug', action:'dialog'},
  ];
  if(!localStorage.getItem('hub.follow')) localStorage.setItem('hub.follow','1');
  document.getElementById('followState').checked = localStorage.getItem('hub.follow') !== '0';
  await reloadAll();
  connect();
})();
</script>
