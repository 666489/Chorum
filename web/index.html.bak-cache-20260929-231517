document.getElementById('clear').onclick = async ()=>{
  if(!confirm('清空**本会话**的上下文？\n\n会清掉：本会话的聊天记录与执行流程 + 各成员**在本会话里**的原生记忆。\n'
    + '别的会话不受影响（它们的原生记忆还在）；公告板、系统提示词、准入授权、成员与模型配置保留。\n此操作不可撤销。')) return;
  const r = await post('/api/clear');
  if(!r.ok){ alert('清空失败：' + r.error); return; }
    applyCleared();
    await loadHealth();
  };

  /* 关闭键：结束中枢进程（服务端会先中断轮次、杀掉子进程、收尾数据库） */
  /* ---------- 会话面板（活动栏「会话」图标开合，形制参考 DeepSeek 的会话列表） ---------- */
  function convGroup(ts){
    const t = ts || 0;
    const now = new Date();
    const startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime() / 1000;
    if(t >= startToday) return '今天';
    if(t >= startToday - 86400) return '昨天';
    if(t >= startToday - 7 * 86400) return '7 天内';
