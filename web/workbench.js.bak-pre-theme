/* Visible collaboration controls. No polling, no external assets. */
(() => {
  const $ = id => document.getElementById(id);
  let view='discussion', snapshot={agents:[]}, workflows=[], memories=[], generation=0, refreshTimer;
  const safe=s=>{const el=document.createElement('span');el.textContent=String(s??'');return el.innerHTML;};
  const toolbar=document.createElement('div'); toolbar.id='workbenchBar';
  toolbar.innerHTML=`<div class="wb-brand">ClaudeLink <span id="wbVersion">0.4.0</span></div>
    <nav aria-label="工作区视图">${[['discussion','讨论'],['tools','工具记录'],['thinking','推理摘要'],['tasks','持续执行'],['memory','记忆']].map(([v,l])=>`<button data-wb-view="${v}" class="${v==='discussion'?'on':''}">${l}</button>`).join('')}</nav>
    <div class="wb-actions"><button id="wbRound">发起圆桌</button><button id="wbWork" class="primary">创建执行任务</button></div>`;
  document.querySelector('main header').after(toolbar);
  const panel=document.createElement('section');panel.id='workbenchPanel';panel.hidden=true;toolbar.after(panel);
  const error=document.createElement('div');error.id='wbError';error.hidden=true;toolbar.before(error);
  function showError(message){error.hidden=false;error.textContent=message;}
  window.showWorkbenchError=showError;
  async function api(path,body){
    const response=await fetch(path,{method:body===undefined?'GET':'POST',headers:{'Content-Type':'application/json','X-ClaudeLink-Token':window.__HUB_TOKEN__||''},...(body===undefined?{}:{body:JSON.stringify(body)})});
    const data=await response.json();
    if(!response.ok||data.ok===false)throw new Error(data.error||`HTTP ${response.status}`);
    return data;
  }
  function card(title,body,meta=''){return `<article class="wb-card"><div class="wb-card-title">${safe(title)}<small>${safe(meta)}</small></div>${body}</article>`;}
  const empty=text=>`<div class="wb-empty">${safe(text)}</div>`;
  async function refresh(){
    if(view==='discussion')return;
    const requestedView=view, request=++generation;
    const current=()=>request===generation&&requestedView===view;
    if(view==='tasks'){
      workflows=(await api('/api/workflows')).workflows||[];
      if(!current())return;
      panel.innerHTML=`<div class="wb-section-head"><div><h2>一次调度，持续执行</h2><p>主代理只生成一次计划，执行代理按依赖持续工作并保存检查点。</p></div><button data-wb-new-work>创建任务</button></div>`+
        (workflows.length?workflows.map(w=>card(w.topic||w.id,`<div class="wb-meta">${safe(w.id)} · ${safe(w.status)} · 主代理 ${safe(w.planner)}</div>${w.error?`<p class="wb-error">${safe(w.error)}</p>`:''}${(w.tasks||[]).map(t=>`<div class="wb-task"><b>${safe(t.id)} · ${safe(t.agent)}</b><span>${safe(t.status)} · ${t.steps||0} 步</span><p>${safe(t.instruction)}</p><pre>${safe(t.summary||t.error||'等待依赖完成')}</pre></div>`).join('')}<div class="wb-actions">${['error','paused'].includes(w.status)?`<button data-wb-resume="${safe(w.id)}">恢复未完成任务</button>`:''}${['planning','running'].includes(w.status)?`<button data-wb-stop="${safe(w.id)}">暂停</button>`:''}</div>`)).join(''):empty('尚无执行任务。创建任务后在这里查看主代理计划与子任务检查点。'));
    }else if(view==='memory'){
      const query=panel.querySelector('#wbMemoryQuery')?.value||'';
      memories=(await api('/api/memory?q='+encodeURIComponent(query))).memories||[];
      if(!current())return;
      panel.innerHTML=`<div class="wb-section-head"><div><h2>项目记忆</h2><p>短期记忆按会话隔离；长期记忆在同一工作区复用，保留来源。</p></div></div><div class="wb-memory-tools"><input id="wbMemoryQuery" placeholder="检索关键词" value="${safe(query)}"><button data-wb-search>检索</button><button data-wb-new-memory>保存记忆</button></div>`+
        (memories.length?memories.map(m=>card(m.kind==='long'?'长期记忆':'短期记忆',`<pre>${safe(m.text)}</pre><div class="wb-meta">${safe(m.source)} · ${safe(m.id)}</div><button data-wb-forget="${safe(m.id)}">删除这条记忆</button>`)).join(''):empty('没有匹配的记忆。保存已确认的经验，任务检查点会自动写入短期记忆。'));
    }else{
      const activity=await api('/api/activity');if(!current())return;const turns=new Map((activity.turns||[]).map(t=>[t.id,t]));
      const steps=Object.values(activity.steps||{}).flat().filter(s=>view==='thinking'?s.kind==='thinking':['tool_call','tool_result','note'].includes(s.kind));
      panel.innerHTML=`<div class="wb-section-head"><div><h2>${view==='thinking'?'推理摘要':'工具执行记录'}</h2><p>${view==='thinking'?'只展示服务商实际返回的可见推理内容。':'查看真实调用参数、结果和失败；工具错误不会被计为成功。'}</p></div></div>`+
        (steps.length?steps.map(s=>{let d=s.detail||'';try{d=JSON.parse(d);}catch{} const text=typeof d==='object'?(d.text||JSON.stringify(d,null,2)):d;
          return `<details class="wb-card" ${view==='thinking'?'open':''}><summary>${safe(turns.get(s.turn_id)?.agent||'')} · ${safe(s.name||s.kind)} <small>${safe(s.status)}</small></summary><pre>${safe(text)}</pre></details>`;}).join(''):empty('尚无记录。执行讨论或任务后，实际工具调用与推理摘要会出现在这里。'));
    }
  }
  async function setView(next){view=next;error.hidden=true;toolbar.querySelectorAll('[data-wb-view]').forEach(b=>b.classList.toggle('on',b.dataset.wbView===view));$('log').hidden=view!=='discussion';$('composer').hidden=view!=='discussion';panel.hidden=view==='discussion';try{await refresh();}catch(e){showError(e.message);}}
  toolbar.addEventListener('click',e=>{const button=e.target.closest('[data-wb-view]');if(button)setView(button.dataset.wbView);});
  function dialog(title,html){const el=document.createElement('dialog');el.className='wb-dialog';el.innerHTML=`<form><div class="wb-dialog-head"><h2>${safe(title)}</h2><button type="button" data-wb-close aria-label="关闭">×</button></div>${html}<p class="wb-error" data-wb-form-error></p><div class="wb-actions"><button type="button" data-wb-close>取消</button><button type="submit" class="primary">开始</button></div></form>`;document.body.append(el);el.querySelectorAll('[data-wb-close]').forEach(b=>b.onclick=()=>el.close());el.onclose=()=>el.remove();el.showModal();return el;}
  async function getSnapshot(){snapshot=await api('/api/state');return snapshot;}
  function enabled(){return(snapshot.agents||[]).filter(a=>a.enabled);}
  const agentOptions=()=>enabled().map(a=>`<option value="${safe(a.name)}">${safe(a.label)}</option>`).join('');
  async function workDialog(){try{await getSnapshot();if(!enabled().length)throw new Error('先添加或启用至少一位成员');
    const el=dialog('创建持续执行任务',`<label>原始目标与验收条件<textarea id="wbWorkTopic" required rows="5" placeholder="需要完成什么，交付哪些实际结果"></textarea></label><label>主代理（只调度一次）<select id="wbPlanner">${agentOptions()}</select></label><fieldset><legend>执行代理</legend>${enabled().map(a=>`<label class="wb-check"><input type="checkbox" name="workers" value="${safe(a.name)}" checked>${safe(a.label)}</label>`).join('')}</fieldset><label>每个子任务最多步数<input id="wbSteps" type="number" value="4" min="1" max="20"></label>`);
    el.querySelector('form').onsubmit=async e=>{e.preventDefault();try{await api('/api/workflows/start',{topic:el.querySelector('#wbWorkTopic').value,planner:el.querySelector('#wbPlanner').value,agents:[...el.querySelectorAll('[name=workers]:checked')].map(n=>n.value),max_steps:Number(el.querySelector('#wbSteps').value)});el.close();await setView('tasks');}catch(e){el.querySelector('[data-wb-form-error]').textContent=e.message;}};
  }catch(e){showError(e.message);}}
  async function roundDialog(){try{await getSnapshot();if(!enabled().length)throw new Error('先添加或启用成员，同一成员可以添加多个独立角色');
    const el=dialog('多智能体圆桌讨论',`<label>原始议题<textarea id="wbRoundTopic" required rows="5" placeholder="讨论对象、必须回答的问题、材料范围与禁止事项"></textarea></label><div id="wbParticipants"></div><button type="button" id="wbAddParticipant">添加角色实例</button><label>讨论轮数<input id="wbRounds" type="number" min="1" max="20" value="2"></label>`);
    function add(agent){const row=document.createElement('div');row.className='wb-participant';row.innerHTML=`<select aria-label="成员">${agentOptions()}</select><input aria-label="角色" placeholder="角色名称"><button type="button" aria-label="移除此角色">移除</button>`;if(agent)row.querySelector('select').value=agent;row.querySelector('button').onclick=()=>row.remove();el.querySelector('#wbParticipants').append(row);}
    enabled().slice(0,3).forEach(a=>add(a.name));if(enabled().length===1)add(enabled()[0].name);el.querySelector('#wbAddParticipant').onclick=()=>add();
    el.querySelector('form').onsubmit=async e=>{e.preventDefault();try{const participants=[...el.querySelectorAll('.wb-participant')].map(row=>({agent:row.querySelector('select').value,role:row.querySelector('input').value}));await api('/api/roundtable/start',{topic:el.querySelector('#wbRoundTopic').value,rounds:Number(el.querySelector('#wbRounds').value),participants,new_conversation:true});el.close();await setView('discussion');await reloadAll();}catch(e){el.querySelector('[data-wb-form-error]').textContent=e.message;}};
  }catch(e){showError(e.message);}}
  function memoryDialog(){const el=dialog('保存项目记忆',`<label>类型<select id="wbMemoryKind"><option value="short">短期：仅当前会话</option><option value="long">长期：同一工作区复用</option></select></label><label>已确认的内容<textarea id="wbMemoryText" rows="5" required></textarea></label>`);el.querySelector('[type=submit]').textContent='保存';el.querySelector('form').onsubmit=async e=>{e.preventDefault();try{await api('/api/memory',{kind:el.querySelector('#wbMemoryKind').value,text:el.querySelector('#wbMemoryText').value,source:'user'});el.close();await refresh();}catch(e){el.querySelector('[data-wb-form-error]').textContent=e.message;}};}
  $('wbWork').onclick=workDialog;$('wbRound').onclick=roundDialog;
  panel.addEventListener('click',async e=>{const b=e.target.closest('button');if(!b)return;try{if(b.hasAttribute('data-wb-new-work'))return workDialog();if(b.hasAttribute('data-wb-new-memory'))return memoryDialog();if(b.hasAttribute('data-wb-search'))return refresh();if(b.dataset.wbForget)await api('/api/memory',{action:'delete',id:b.dataset.wbForget});if(b.dataset.wbResume)await api('/api/workflows/resume',{id:b.dataset.wbResume});if(b.dataset.wbStop)await api('/api/workflows/stop',{id:b.dataset.wbStop});await refresh();}catch(e){showError(e.message);}});
  window.enhanceMemberPanel=async(a,body)=>{try{const caps=await api('/api/capabilities');if(!body.isConnected||$('mpEffort'))return;const block=document.createElement('div');block.className='mp-sec';block.innerHTML=`<h3>推理强度 effort</h3><select id="mpEffort">${(caps.effort[a.name]||['']).map(v=>`<option value="${safe(v)}">${safe(v||'auto（跟随默认）')}</option>`).join('')}</select><span class="note" id="mpEffortNote"></span>`;body.append(block);block.querySelector('select').value=a.effort||'';block.querySelector('select').onchange=async e=>{try{await api('/api/agents/effort',{agent:a.name,effort:e.target.value});block.querySelector('#mpEffortNote').textContent='已应用';await loadAgents();}catch(e){block.querySelector('#mpEffortNote').textContent=e.message;}};}catch(e){showError(e.message);}};
  window.addEventListener('hub-event',event=>{if(view!=='discussion'&&['workflow','step','turn_ended','conversation','cleared'].includes(event.detail.type)){clearTimeout(refreshTimer);refreshTimer=setTimeout(()=>refresh().catch(e=>showError(e.message)),120);}});
  window.addEventListener('unhandledrejection',e=>{showError('界面操作失败：'+(e.reason?.message||e.reason));});
  getSnapshot().then(s=>{$('wbVersion').textContent=s.health?.version||'服务版本未知';}).catch(e=>showError('初始化失败：'+e.message));
})();
